// Lid-driven cavity at Re = 100. Steady incompressible Navier-Stokes in
// 2D with equal-order linear elements and SUPG/PSPG stabilization. The
// u-velocity on the vertical centreline is checked against Ghia et al.
// (1982), Table I.

model cavity: 2d, SI

let a: Length = 1 m
let U: Velocity = 1 m/s
let Re: Real = 100

scales a, U, 1 kg/m^3

let cav: Surface = rect((0, 0) m, (a, a))
let lid: Curve = boundary(cav, y == a)
let walls: Curve = boundary(cav, y < a)
let corner: Point = point((0, 0) m)

material fluid {
    rho: Density = 1 kg/m^3
    mu: DynViscosity = rho*U*a/Re
}

mesh m on cav {
    size: a/64
    cell: tri
    refine lid: a/128
}

physics flow on cav: navier_stokes solves v: Vector<Velocity>, p: Pressure {
    material fluid
}

method flow: cg {
    mesh: m
    order: { v: 1, p: 1 }
    stabilize: supg_pspg
}

step steady: static {
    bc lid: v = (U, 0)
    bc walls: v = 0
    bc corner: p = 0
    solve { nonlinear: newton, linear: gmres, precond: ilu0, rtol: 1e-8 }
    output v, p
}

table ghia_u{y: Length in m, u: Velocity in m/s}:
    1.0000, 1.00000
    0.9766, 0.84123
    0.8516, 0.23151
    0.7344, 0.00332
    0.5000, -0.20581
    0.2813, -0.15662
    0.1016, -0.06434
    0.0000, 0.00000

expect centreline: v.x at (a/2, ghia_u.y) == ghia_u.u within 0.02 m/s
