// A manufactured solution of steady advection-diffusion on the unit
// square, with fv: u = sin(pi x/L) sin(pi y/L) u0, and the source that
// makes it exact. The face values are second order (linear_upwind with
// the van_leer limiter), so `skein verify convergence` measures an L2
// order near 2.

model mms_fv_static: 2d, SI

let L: Length = 1 m
let u0: Temperature = 1 K
let ax: Velocity = 1 m/s
let ay: Velocity = 0.5 m/s
let a: Vector<Velocity> = (1, 0.5) m/s
let d: KinViscosity = 0.01 m^2/s

scales L, u0, 1 s

let sq: Surface = rect((0, 0) m, (L, L))
let edge: Curve = boundary(sq)

mesh grid on sq {
    size: 0.125 m
    cell: quad
}

physics heat on sq solves u: Temperature {
    eq div(a*u) - d*div(grad(u)) =
        pi/L*u0*(ax*cos(pi*x/L)*sin(pi*y/L) + ay*sin(pi*x/L)*cos(pi*y/L)) +
            2*d*(pi/L)^2*u0*sin(pi*x/L)*sin(pi*y/L)
}

method heat: fv { mesh: grid, flux: linear_upwind, limiter: van_leer }

bc edge: u = 0 K

step steady: static {
    report u at (L/2, L/2)
    output u
}

expect mms: u == sin(pi*x/L)*sin(pi*y/L)*u0 within 5%
