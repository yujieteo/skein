// femahoy: fixtures/results/cantilever-2step/cantilever-2step.inp
// A steel beam of 10 x 1 x 1 mm, fixed at x = 0. Step 1 puts a load of
// 2.25 N in -z on the tip. Step 2 doubles it. Linear static, 3D, quadratic
// tetrahedra. The viewer tests of femahoy read its results. It has no reference.

model cantilever_2step: 3d, mm_N_MPa_s

let L: Length = 10 mm
let W: Length = 1 mm
let P: Force = 2.25 N

scales W, P/(W*W)

let beam: Solid = box((0, 0, 0) mm, (L, W, W))
let fixed: Surface = boundary(beam, x == 0 mm)
// The 9 nodes of the tip face of femahoy: the corners, the mid-sides and the centre.
let tip: Point = pattern(pattern(point((L, 0 mm, 0 mm)), (0 mm, W/2, 0 mm), 3), (0 mm, 0 mm, W/2), 3)

material steel {
    E: Pressure = 210000 MPa
    nu: Real = 0.3
}

mesh m on beam {
    size: 1 mm
    cell: tet
}

physics solid on beam: linear_elastic solves u: Vector<Length> {
    material steel
}

bc fixed: u = 0

// femahoy puts P/9 = 0.25 N in -z on each of the 9 tip nodes.
step tip_load: static {
    bc tip: sigma*n = (0 N, 0 N, -P/9)
    output u, sigma
    report reaction(fixed)
}

step double_load: static {
    bc tip: sigma*n = (0 N, 0 N, -2*P/9)
    output u, sigma
    report reaction(fixed)
}
