// femahoy: validation/cases/hyperelastic-tube/job.inp
// blocked-by: G36
// A quarter of a long rubber tube in plane strain (A = 10 mm, B = 20 mm), 3-term Ogden rubber
// (Ogden 1972), nearly incompressible. The inner face moves out to 2.5 and then 4 times its
// radius, past the pressure maximum. References (Haughton and Ogden 1979): F = 5.74269 N at
// 2.5, F = 8.76165 N and u(B) = 23.5890 mm at 4.0.

model hyperelastic_tube: 2d, mm_N_MPa_s

let A_in: Length = 10 mm
let B_out: Length = 20 mm
let th: Length = 1 mm
let mu0: Pressure = 0.414331 MPa

scales A_in, mu0

let bore: Surface = circle((0, 0) mm, A_in)
let quarter: Surface = (circle((0, 0) mm, B_out) & rect((0, 0) mm, (B_out, B_out))) - bore
let sx: Curve = boundary(quarter, x == 0 mm)
let sy: Curve = boundary(quarter, y == 0 mm)
let inner: Curve = boundary(quarter, bore)

/// One Ogden term mp/al*(sum of the isochoric stretches^al - 3), with c1, c2 the in-plane
/// eigenvalues of C and the axial stretch 1 (plane strain).
// gap G30: the exponents al/2 and -al/3 are not integer constants (§6.1).
fn ogden(c1: Real, c2: Real, jac: Real, mp: Pressure, al: Real) -> Energy/Volume = mp/al*(jac^(-al/3)*(c1^(al/2) + c2^(al/2) + 1) - 3)

// mu_p of the paper. Kb = 2/D1 with D1 = 0.0005 1/MPa of job.inp.
material rubber {
    mu1: Pressure = 0.617819 MPa
    al1: Real = 1.3
    mu2: Pressure = 0.00117680 MPa
    al2: Real = 5.0
    mu3: Pressure = -0.00980665 MPa
    al3: Real = -2.0
    Kb: Pressure = 4000 MPa
}

// gap G36: the mesher makes quad cells only on a union of rects, so the tube uses
// triangles. ccx uses CPE8R: order: 2, family: serendipity and quadrature: reduced on
// quad cells.
mesh m on quarter {
    size: 1.25 mm
    cell: tri
}

physics tube on quarter solves u: Vector<Length> {
    material rubber
    assume finite_strain, isotropic, plane_strain(th)
    let C: Tensor2<Real> = transpose(defgrad(u))*defgrad(u)
    let c: Vector<Real> = principal(C)
    let J: Real = sqrt(det(C))
    let W: Energy/Volume = ogden(c.x, c.y, J, mu1, al1) + ogden(c.x, c.y, J, mu2, al2) + ogden(c.x, c.y, J, mu3, al3) + Kb/2*(J - 1)^2
    let S: Tensor2<Pressure> = 2*diff(W, C)
    eq div(defgrad(u)*S) = 0
}

bc sx: u.x = 0
bc sy: u.y = 0

// A pressure load cannot pass the maximum. Thus the inner face moves radially.
step inflate_25: static(ramp: 20) {
    bc inner: u = (15 mm)/A_in*(x, y)
    expect f_25: reaction(inner).x == 5.74269 N within 0.2%
}

step inflate_40: static(ramp: 20) {
    bc inner: u = (30 mm)/A_in*(x, y)
    output u, S
    report f_40 = reaction(inner).x
}

expect f_40: reaction(inner).x == 8.76165 N within 0.2%
expect u_outer: u.x at (B_out, 0 mm) == 23.5890 mm within 0.2%
