// femahoy: validation/cases/grid-resistor-bar/bar/grid.toml
// DC conduction in a copper bar 10 x 1 x 2 mm with 1 V across its ends.
// The resistance R = L/(sigma*A) = 8.6206896552e-5 ohm is exact on linear hex cells.

model resistor_bar: 3d, mm_N_MPa_s

let L: Length = 10 mm
let V0: Power/Current = 1 V

scales L, V0, 1 kA

let bar: Solid = box((0, 0, 0) mm, (L, 1 mm, 2 mm))
let left: Surface = boundary(bar, x == 0 mm)
let right: Surface = boundary(bar, x == L)

material copper {
    sigma_e: Current^2/(Power*Length) = 5.8e7 A/(V*m)
}

mesh m on bar {
    size: 0.5 mm
    cell: hex
}

// The electric potential phi has no named dimension. Power/Current is the volt.
physics elec on bar solves phi: Power/Current {
    material copper
    let J: Vector<Current/Area> = -sigma_e*grad(phi)
    eq div(J) = 0
}

method elec: cg { mesh: m, order: 1 }

step conduct: static {
    bc left: phi = V0
    bc right: phi = 0
    output phi, J
}

// n points out of the bar, so the current into the bar at left is -integral(dot(J, n), left).
expect resistance: -V0/integral(dot(J, n), left) == 8.6206896552e-5 V/A within 1e-7%
