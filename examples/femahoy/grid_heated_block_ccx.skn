// femahoy: validation/cases/grid-heated-block-ccx/block/grid.toml
// blocked-by: G19
// A steel plate with a copper block on its top. A heat source in the block, a convection
// on the bottom of the plate, the other faces adiabatic. The temperatures are checked
// against CalculiX 2.23 with C3D20 elements: 48.45740, 34.98249 and 36.92743 degC.

model heated_block: 3d, SI

let T_air: Temperature = 20 degC
let h_c: HeatTransfer = 200 W/(m^2*K)

scales 0.01 m, 10 K, 50 W/(m*K)

let plate: Solid = box((0, 0, 0) m, (0.1, 0.1, 0.01) m)
let block: Solid = box((0.035, 0.035, 0.01) m, (0.065, 0.065, 0.03) m)
let part: Solid = plate | block
let bottom: Surface = boundary(part, z == 0 m)

material steel {
    k: Conductivity = 50 W/(m*K)
    qv: Power/Volume = 0 W/m^3
}

material copper {
    k: Conductivity = 400 W/(m*K)
    qv: Power/Volume = 2e6 W/m^3
}

// gap G19: hex cells need 1 box, and the part is a union of 2 boxes. Thus the cells are tetrahedra.
mesh m on part {
    size: 0.000625 m
    cell: tet
}

physics thermal on part solves T: Temperature {
    material steel on plate, copper on block
    let q: Vector<HeatFlux> = -k*grad(T)
    eq div(q) = qv
}

step steady: static {
    bc bottom: dot(q, n) = h_c*(T - T_air)
    output T, q
}

expect block_top: T at (0.05, 0.05, 0.03) m == 48.45740 degC within 0.2 K
expect plate_corner: T at (0, 0, 0) m == 34.98249 degC within 0.2 K
expect plate_edge_top: T at (0.05, 0, 0.01) m == 36.92743 degC within 0.2 K
