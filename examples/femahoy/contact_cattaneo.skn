// femahoy: validation/cases/contact-cattaneo/job.inp
// blocked-by: G23 G36
// A cylindrical steel pad (R = 20 mm) on a steel block, plane strain, 1 mm thick, friction
// 0.3. The pad gets P = 4500 N, then Q = 0.75*mu*P. The centre of the contact sticks and its
// edges slip (Cattaneo 1938). References: p0 = 2874.69 MPa, q(0) = 431.203 MPa.

model contact_cattaneo: 2d, mm_N_MPa_s

let R: Length = 20 mm
let th: Length = 1 mm
let hp: Length = 20 mm
let P: Force = 4500 N
let mu_f: Real = 0.3
let Q: Force = 0.75*mu_f*P
let p_h: Pressure = 2874.69 MPa

scales R, p_h

let disk: Surface = circle((0 mm, R), R)
let block: Surface = rect((-20, -20) mm, (20, 0) mm)
let pad: Surface = disk & rect((-12, 0) mm, (12, 20) mm)
let parts: Surface = block | pad
let bottom: Curve = boundary(parts, y == -20 mm)
let top: Curve = boundary(parts, y == hp)
let c: Point = point((0 mm, hp))
let block_face: Curve = boundary(block, y == 0 mm)
let pad_face: Curve = boundary(pad, disk)
let zone: Surface = rect((-1.4, -0.6) mm, (1.4, 0.6) mm)

material steel {
    E: Pressure = 210 GPa
    nu: Real = 0.3
}

// gap G36: the mesher makes quad cells only on a union of rects, so the parts use
// triangles. ccx uses CPE4: order: 1 on quad cells.
mesh m on parts {
    size: 2 mm
    cell: tri
    refine zone: 0.04 mm
}

physics solid on parts: linear_elastic solves u: Vector<Length> {
    material steel
    assume plane_strain(th)
}

// Master: the block. Slave: the pad.
contact rough: block_face, pad_face {
    friction: mu_f
    enforce: penalty
    stiffness: 1e7 MPa/mm
}
// gap G23: no stick stiffness for the friction (ccx: 1e7 MPa/mm).

bc bottom: u = 0

// Push the top down. This starts the contact.
step press: static {
    bc top: u = (0, -0.02) mm
}

// The top stays straight and can turn about c (ccx *EQUATION). c takes the loads.
step normal: static {
    bc top: u = rigid(c)
    bc c: u.x = 0
    bc c: sigma*n = (0, -P)
}

// Q acts on the top, 20 mm above the contact. The moment hp*Q about c makes the resultant
// pass through the centre of the contact, as in the theory.
step slide: static(ramp: 20) {
    release c
    bc c: sigma*n = (Q, -P)
    bc c: moment(sigma*n) = hp*Q
    output u, sigma
}

// On the block face, -sigma.yy is the contact pressure and sigma.xy is the shear traction.
expect p0: max(-sigma.yy, block_face) == p_h within 2%

expect q_centre: sigma.xy at (0 mm, -0.02 mm) == 431.203 MPa within 2%
