// femahoy: validation/cases/grid-free-block-modes-ccx/block/grid.toml
// A free steel block 60 x 40 x 10 mm with no support: its 6 rigid modes and its first
// 6 elastic modes. The reference is CalculiX 2.23 with C3D20 elements: modes 7 to 12 at
// 11961.42, 13530.06, 25595.73, 28841.65, 31574.5 and 31633.88 Hz, within 0.5 %.

model free_block_modes: 3d, mm_N_MPa_s

scales 10 mm, 210 GPa, 7.85e-9 t/mm^3

let block: Solid = box((0, 0, 0) mm, (60, 40, 10) mm)

material steel {
    E: Pressure = 210 GPa
    nu: Real = 0.3
    rho: Density = 7.85e-9 t/mm^3
}

mesh m on block {
    size: 1.25 mm
    cell: hex
}

physics solid on block solves u: Vector<Length> {
    material steel
    assume small_strain, isotropic
    let sigma: Tensor2<Pressure> = hooke(E, nu, strain(u))
    eq rho*ddt2(u) - div(sigma) = 0
}

// The 8-node hex with incompatible modes of the grid solver.
method solid: cg { mesh: m, order: 1, family: incompatible }

allow rigid_body: "a free block: the modal step finds its 6 rigid modes at 0 Hz"

step modes: modal(count: 12) {
    output u
}

// Modes 1 to 6 are the rigid modes.
expect f7: eigenvalue(7) == 11961.42 Hz within 0.5%

expect f8: eigenvalue(8) == 13530.06 Hz within 0.5%

expect f9: eigenvalue(9) == 25595.73 Hz within 0.5%

expect f10: eigenvalue(10) == 28841.65 Hz within 0.5%

expect f11: eigenvalue(11) == 31574.5 Hz within 0.5%

expect f12: eigenvalue(12) == 31633.88 Hz within 0.5%
