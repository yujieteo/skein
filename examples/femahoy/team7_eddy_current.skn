// femahoy: validation/cases/team7-eddy-current/50hz/case.pro
// blocked-by: G26 G27
// TEAM problem 7: an aluminium plate with an off-centre hole under a coil with 50 Hz current.
// Time-harmonic eddy currents with the vector potential a, E = -im*omega*a in the plate.
// Reference: Bz on the line A1-B1 at omega*t = 0 and 90 deg (Fujiwara and Nakata 1990).

model team7_eddy_current: 3d, SI

let f0: Frequency = 50 Hz
let omega: Frequency = 2*pi*f0
let mu0: Mass*Length/(Time^2*Current^2) = 4*pi*1e-7 V*s/(A*m)
let sigma_al: Current^2*Time^3/(Mass*Length^3) = 3.526e7 A/(V*m)
let turns: Current = 2742 A
let j0: Current/Area = turns/(25 mm*100 mm)
let gauss: Mass/(Time^2*Current) = 1e-4 V*s/m^2
// The coil centre and the half side of the square that the coil goes round.
let xc: Length = 194 mm
let yc: Length = 100 mm
let bh: Length = 50 mm

scales 294 mm, 1/omega, 100*gauss, turns

let plate: Solid = box((0, 0, 0) mm, (294, 294, 19) mm) - box((18, 18, -1) mm, (126, 126, 20) mm)
/// The square of half side bh round (xc, yc), grown by r with round corners, from z = 49 mm to 149 mm.
fn stadium(r: Length) -> Solid = box((xc - bh - r, yc - bh, 49 mm), (xc + bh + r, yc + bh, 149 mm)) | box((xc - bh, yc - bh - r, 49 mm), (xc + bh, yc + bh + r, 149 mm)) | pattern(pattern(cylinder((xc - bh, yc - bh, 49 mm), (0, 0, 1), r, 100 mm), (2*bh, 0 mm, 0 mm), 2), (0 mm, 2*bh, 0 mm), 2)
let coil: Solid = stadium(50 mm) - stadium(25 mm)
let world: Solid = sphere((147, 147, 74) mm, 0.45 m)
let air: Solid = world - plate - coil
let outer_face: Surface = boundary(world)
let band: Solid = box((-6, 62, 26) mm, (294, 82, 42) mm)

// The current goes round the coil anticlockwise, seen from +z. (dxs, dys) points from the
// nearest point of the square of half side bh to the point, thus along the normal of the
// rounded coil. The current is along the tangent.
let dxs: Length = x - xc - max(-bh, min(bh, x - xc))
let dys: Length = y - yc - max(-bh, min(bh, y - yc))
let dc: Length = sqrt(dxs^2 + dys^2)

material aluminium {
    nu_m: Time^2*Current^2/(Mass*Length) = 1/mu0
    sig: Current^2*Time^3/(Mass*Length^3) = sigma_al
    js: Vector<Current/Area> = 0
}

material winding {
    nu_m: Time^2*Current^2/(Mass*Length) = 1/mu0
    sig: Current^2*Time^3/(Mass*Length^3) = 0
    js: Vector<Current/Area> = j0*(-dys/dc, dxs/dc, 0)
}

material vacuum {
    nu_m: Time^2*Current^2/(Mass*Length) = 1/mu0
    sig: Current^2*Time^3/(Mass*Length^3) = 0
    js: Vector<Current/Area> = 0
}

mesh m on world {
    size: 50 mm
    refine plate: 5 mm
    refine coil: 10 mm
    refine band: 3 mm
}

physics em on world solves a: Vector<Complex<Mass*Length/(Time^2*Current)>> {
    material aluminium on plate, winding on coil, vacuum on air
    let h: Vector<Complex<Current/Length>> = nu_m*curl(a)
    eq curl(h) + im*omega*sig*a = js
}

// gap G27: no gauge. The edge elements of a are not unique in the air and the coil.
method em: cg {
    mesh: m
    order: 1
    family: nedelec
}

step ac: harmonic(freq: [f0]) {
    // gap G26: no infinite region. femahoy maps a shell from 0.35 m to 0.45 m to infinity.
    // Here a = 0 on the sphere of 0.45 m.
    bc outer_face: a = 0
    output a, curl(a)
    report bz_36 = curl(a).z at (36, 72, 34) mm
    report bz_126 = curl(a).z at (126, 72, 34) mm
    report bz_162 = curl(a).z at (162, 72, 34) mm
}

// The time factor is exp(im*omega*t). Thus Bz at 0 deg is the real part, and Bz at 90 deg is
// minus the imaginary part. femahoy checks each part within 6% + 1 G.
expect bz0_36: re(curl(a).z at (36, 72, 34) mm) == -22.13*gauss within 0.06*22.13*gauss + gauss
expect bz90_36: -imag(curl(a).z at (36, 72, 34) mm) == 4.15*gauss within 0.06*4.15*gauss + gauss
expect bz0_126: re(curl(a).z at (126, 72, 34) mm) == 78.11*gauss within 0.06*78.11*gauss + gauss
expect bz90_126: -imag(curl(a).z at (126, 72, 34) mm) == 4.97*gauss within 0.06*4.97*gauss + gauss
expect bz0_162: re(curl(a).z at (162, 72, 34) mm) == 60.44*gauss within 0.06*60.44*gauss + gauss
expect bz90_162: -imag(curl(a).z at (162, 72, 34) mm) == 14.15*gauss within 0.06*14.15*gauss + gauss
