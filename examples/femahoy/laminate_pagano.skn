// femahoy: validation/cases/laminate-pagano/job.inp
// blocked-by: G18
// The square [0/90/0] plates of Pagano (1970), simply supported, with the
// load q0*sin(pi*x/a)*sin(pi*y/a) on the top face. 1/4 of each plate. The
// thick plate (a/h = 4) has 3D layers of quadratic hexahedra. The thin plate
// (a/h = 100) is a composite shell at z = -100 mm. The references are the
// exact 3D solution at the femahoy points (pagano.py), within 0.5 %.

model laminate_pagano: 3d, mm_N_MPa_s

let a: Length = 100 mm
let h: Length = 25 mm
let q0: Pressure = 1 MPa
let E_L: Pressure = 175000 MPa
let E_T: Pressure = 7000 MPa
let G_LT: Pressure = 3500 MPa
let G_TT: Pressure = 1400 MPa
let nu_p: Real = 0.25
let h_thin: Length = 1 mm
let q_thin: Pressure = 1.0e-3 MPa
let z_thin: Length = -100 mm

scales h, E_T

let plate: Solid = box((0 mm, 0 mm, -h/2), (a/2, a/2, h/2))
let ply_bot: Solid = box((0 mm, 0 mm, -h/2), (a/2, a/2, -h/6))
let core: Solid = box((0 mm, 0 mm, -h/6), (a/2, a/2, h/6))
let ply_top: Solid = box((0 mm, 0 mm, h/6), (a/2, a/2, h/2))
let ss_x: Surface = boundary(plate, x == 0 mm)
let ss_y: Surface = boundary(plate, y == 0 mm)
let sym_x: Surface = boundary(plate, x == a/2)
let sym_y: Surface = boundary(plate, y == a/2)
let top: Surface = boundary(plate, z == h/2)
let thin_box: Solid = box((0 mm, 0 mm, z_thin - h_thin), (a/2, a/2, z_thin))
let thin: Surface = boundary(thin_box, z == z_thin)
let thin_ss_x: Curve = boundary(thin, x == 0 mm)
let thin_ss_y: Curve = boundary(thin, y == 0 mm)
let thin_sym_x: Curve = boundary(thin, x == a/2)
let thin_sym_y: Curve = boundary(thin, y == a/2)
// The femahoy element of the core at the edge x = 0, next to y = a/2.
let edge_cell: Solid = box((0 mm, 7*a/16, -h/18), (a/16, a/2, h/18))

// The engineering constants in the x, y, z axes. The fibre is on x at 0 deg.
material ply0 {
    Ex: Pressure = E_L
    Ey: Pressure = E_T
    Ez: Pressure = E_T
    nxy: Real = nu_p
    nxz: Real = nu_p
    nyz: Real = nu_p
    Gxy: Pressure = G_LT
    Gxz: Pressure = G_LT
    Gyz: Pressure = G_TT
}

// The fibre is on y at 90 deg.
material ply90 {
    Ex: Pressure = E_T
    Ey: Pressure = E_L
    Ez: Pressure = E_T
    nxy: Real = nu_p*E_T/E_L
    nxz: Real = nu_p
    nyz: Real = nu_p
    Gxy: Pressure = G_LT
    Gxz: Pressure = G_TT
    Gyz: Pressure = G_LT
}

// The plies of the thin plate from the top face.
table pagano{angle: Angle in deg}:
    0
    90
    0

material thin_ply {
    E1: Pressure = E_L
    E2: Pressure = E_T
    G12: Pressure = G_LT
    nu12: Real = nu_p
    t_ply: Length = h_thin/3
    h: Length = h_thin
}

// size h/9 puts 3 cells in each ply. gap G18: femahoy uses C3D20R.
mesh m on plate {
    size: h/9
    cell: hex
}

// The orthotropic law, written out: hooke takes only E and nu.
physics solid on plate solves u: Vector<Length> {
    material ply0 on ply_bot | ply_top, ply90 on core
    assume small_strain
    let D_o: Real = 1 - nxy^2*Ey/Ex - nyz^2*Ez/Ey - nxz^2*Ez/Ex - 2*nxy*nyz*nxz*Ez/Ex
    let C11: Pressure = Ex*(1 - nyz^2*Ez/Ey)/D_o
    let C22: Pressure = Ey*(1 - nxz^2*Ez/Ex)/D_o
    let C33: Pressure = Ez*(1 - nxy^2*Ey/Ex)/D_o
    let C12: Pressure = (nxy*Ey + nxz*nyz*Ez)/D_o
    let C13: Pressure = Ez*(nxz + nxy*nyz)/D_o
    let C23: Pressure = Ez*(nyz + nxy*nxz*Ey/Ex)/D_o
    let ex: Vector<Real> = (1, 0, 0)
    let ey: Vector<Real> = (0, 1, 0)
    let ez: Vector<Real> = (0, 0, 1)
    let eps: Tensor2<Real> = strain(u)
    let sigma: Tensor2<Pressure> = (C11*eps.xx + C12*eps.yy + C13*eps.zz)*outer(ex, ex) +
        (C12*eps.xx + C22*eps.yy + C23*eps.zz)*outer(ey, ey) +
        (C13*eps.xx + C23*eps.yy + C33*eps.zz)*outer(ez, ez) +
        2*Gxy*eps.xy*(outer(ex, ey) + outer(ey, ex)) +
        2*Gxz*eps.xz*(outer(ex, ez) + outer(ez, ex)) +
        2*Gyz*eps.yz*(outer(ey, ez) + outer(ez, ey))
    eq div(sigma) = 0
}

mesh m_thin on thin {
    size: 2.5 mm
    cell: quad
}

// gap G18: femahoy uses S8R. The bottom ply is at 0 deg, so Q_ply is in x, y.
physics plate_shell on thin: reissner_mindlin(
    layup: pagano.angle,
    top: (0, 0, 1),
    q: (0 MPa, 0 MPa, -q_thin*sin(pi*x/a)*sin(pi*y/a)),
) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material thin_ply
    let s_bot: Tensor2<Pressure> = ddot(Q_ply, eps_m - h_thin/2*kappa)
}

method plate_shell: cg { mesh: m_thin, order: 1 }

step load: static {
    // Simple support of Pagano on x = 0 and y = 0, symmetry on x = a/2 and y = a/2.
    bc ss_x: u.y = 0
    bc ss_x: u.z = 0
    bc ss_y: u.x = 0
    bc ss_y: u.z = 0
    bc sym_x: u.x = 0
    bc sym_y: u.y = 0
    bc top: sigma*n = (0, 0, -q0*sin(pi*x/a)*sin(pi*y/a))
    bc thin_ss_x: w.y = 0
    bc thin_ss_x: w.z = 0
    bc thin_ss_y: w.x = 0
    bc thin_ss_y: w.z = 0
    bc thin_sym_x: w.x = 0
    bc thin_sym_x: theta.y = 0
    bc thin_sym_y: w.y = 0
    bc thin_sym_y: theta.x = 0
    output u, sigma, w, s_bot
}

// The thin plate: w̄ = 0.4347 and σ̄_xx = 0.5393 (derivation.md), at the
// centre and at the centre of the bottom face.
expect w_thin: w.z at (a/2, a/2, z_thin) == -0.4347*q_thin*a^4/(100*E_T*h_thin^3) within 0.5%
expect sx_thin: s_bot.xx at (a/2, a/2, z_thin) == 0.5393*q_thin*(a/h_thin)^2 within 0.5%
expect w_thick: u.z at (a/2, a/2, 0 mm) == -0.0183398 mm within 0.5%
expect sx_thick: sigma.xx at (48.679, 48.679, -11.913) mm == 10.3419 MPa within 0.5%
expect txz_thick: mean(sigma.xz, edge_cell) == -1.01034 MPa within 0.5%
