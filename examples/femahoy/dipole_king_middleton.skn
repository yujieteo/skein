// femahoy: validation/cases/dipole-king-middleton/omega12.5/openems.py
// blocked-by: G13
// A centre-fed strip dipole in free space, half length 77.7 mm, width 1.2 mm (equivalent
// radius 0.3 mm, Omega = 12.5), with a delta-gap feed. Time-harmonic Maxwell equations for E.
// Reference: King and Middleton, X = -185.7 ohm at beta*h = 1.2, R = 71.02 ohm at 1.5.

model dipole_king_middleton: 3d, SI

param bh: Real = 1.5 in 1.2..1.6
let c0: Velocity = 299792458 m/s
let mu0: Mass*Length/(Time^2*Current^2) = 4*pi*1e-7 V*s/(A*m)
let eps0: Current^2*Time^4/(Mass*Length^3) = 1/(mu0*c0^2)
let hl: Length = 77.7 mm
let w_s: Length = 1.2 mm
let g_f: Length = 0.6 mm
let v0: Mass*Length^2/(Time^3*Current) = 1 V
let f0: Frequency = bh*c0/(2*pi*hl)
let ex: Vector<Real> = (1, 0, 0)
let ey: Vector<Real> = (0, 1, 0)
let ez: Vector<Real> = (0, 0, 1)

scales hl, c0, 1 V/m, 1 A

// 100 mm of air on each side of the dipole, then a PML of 8 cells of 5 mm, as in femahoy.
let air: Solid = box((-100.6, -100, -177.7) mm, (100.6, 100, 177.7) mm)
let world: Solid = box((-140.6, -140, -217.7) mm, (140.6, 140, 217.7) mm)
let layer: Solid = world - air
// The strip is in the plane y = 0, on the top face of the lower half of the air.
let lower: Solid = box((-100.6, -100, -177.7) mm, (100.6, 0, 177.7) mm)
let strip: Surface = boundary(lower, y == 0 mm && abs(x) <= w_s/2 && abs(z) >= g_f/2 && abs(z) <= hl)
let feed: Surface = boundary(lower, y == 0 mm && abs(x) <= w_s/2 && abs(z) < g_f/2)
// A loop round the strip at z = 1 mm, anticlockwise seen from +z, for the current.
let lp_s: Curve = line((-2, -2, 1) mm, (2, -2, 1) mm)
let lp_e: Curve = line((2, -2, 1) mm, (2, 2, 1) mm)
let lp_n: Curve = line((-2, 2, 1) mm, (2, 2, 1) mm)
let lp_w: Curve = line((-2, -2, 1) mm, (-2, 2, 1) mm)

material vacuum {
    mu: Mass*Length/(Time^2*Current^2) = mu0
    eps: Current^2*Time^4/(Mass*Length^3) = eps0
}

mesh m on world {
    size: 5 mm
    cell: tet
    refine strip | feed: 0.3 mm
}

// curl(hc) is written as div(th): th*w = cross(w, hc) for each vector w. Thus th*n is the
// natural condition cross(n, hc) on the outer faces.
physics em on world solves ef: Vector<Complex<Mass*Length/(Time^3*Current)>> {
    material vacuum
    let hc: Vector<Complex<Current/(Time*Length)>> = curl(ef)/mu
    let th: Tensor2<Complex<Current/(Time*Length)>> = outer(cross(ex, hc), ex) + outer(cross(ey, hc), ey) + outer(cross(ez, hc), ez)
    eq div(th) - omega^2*eps*ef = 0
}

method em: cg {
    mesh: m
    order: 2
    family: nedelec
    pml: { region: layer, thickness: 40 mm }
}

step tone: harmonic(freq: [f0]) {
    // The strip is a perfect conductor with no thickness: no tangential E on it.
    bc strip: ef.x = 0
    bc strip: ef.z = 0
    // The delta gap: the voltage v0 across the gap drives the current along +z.
    bc feed: ef.x = 0
    bc feed: ef.z = -v0/g_f
    // Behind the PML, the default natural condition th*n = 0.
    output ef
    // H = curl(ef)/(-im*omega*mu0) = im*hc/omega. The current is the loop integral of H.
    report z_in = v0/(im/omega*(integral(hc.x, lp_s) + integral(hc.y, lp_e) - integral(hc.x, lp_n) - integral(hc.y, lp_w)))
}

study band: grid {
    bh: [1.2, 1.5, pi/2]
}

// The reference gives Im(z_in) at bh = 1.2 and Re(z_in) at bh = 1.5 only, so each has a study
// of one case. z_in is in V/A (ohm). omega after the steps is 2*pi*f0, the frequency of the
// last harmonic step.
study reactance: grid {
    bh: [1.2]
    expect x_in: imag(v0/(im/omega*(integral(hc.x, lp_s) + integral(hc.y, lp_e) -
        integral(hc.x, lp_n) - integral(hc.y, lp_w)))) == -185.7 V/A within 6%
}

study resistance: grid {
    bh: [1.5]
    expect r_in: re(v0/(im/omega*(integral(hc.x, lp_s) + integral(hc.y, lp_e) -
        integral(hc.x, lp_n) - integral(hc.y, lp_w)))) == 71.02 V/A within 6%
}

// gap G13: no far field. The checks need the directivity 1.641 at bh = pi/2 within 6%, and the
// radiated power over the power into the feed, 1 within 6%.
