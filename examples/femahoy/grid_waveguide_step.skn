// femahoy: validation/cases/grid-waveguide-step/step/grid.toml
// A symmetric H-plane step from WR-90 (22.86 mm) to a guide 16 mm wide, with a TE10 port at each
// end, 25 mm from the step, at 10 GHz. The reference is the GetDP solution at 0.5 mm:
// S11 = 0.199629 - 0.304586 im, S21 = 0.737493 + 0.568202 im.

model waveguide_step: 3d, mm_N_MPa_s

let a1: Length = 22.86 mm
let a2: Length = 16 mm
let x2: Length = 3.43 mm
let b: Length = 10.16 mm
let Lw: Length = 25 mm
let f0: Frequency = 10 GHz
let E0: Power/(Current*Length) = 1 V/m
let eps0: Current^2*Time/(Power*Length) = 8.8541878128e-12 C/(V*m)
let mu0: Power*Time/(Current^2*Length) = 1.25663706212e-6 V*s/(A*m)

scales a1, 1 V, 1 mA, 1/f0

// The propagation constants and the mode shapes of TE10 in the 2 guides.
let beta1: Length^-1 = sqrt((2*pi*f0)^2*mu0*eps0 - (pi/a1)^2)
let beta2: Length^-1 = sqrt((2*pi*f0)^2*mu0*eps0 - (pi/a2)^2)
let e1: Vector<Power/(Current*Length)> = (0, E0*sin(pi*x/a1), 0)
let e2: Vector<Power/(Current*Length)> = (0, E0*sin(pi*(x - x2)/a2), 0)

let wide: Solid = box((0, 0, 0) mm, (a1, b, Lw))
let narrow: Solid = box((x2, 0 mm, Lw), (x2 + a2, b, 2*Lw))
let guide: Solid = wide | narrow
let port_in: Surface = boundary(guide, z == 0 mm)
let port_out: Surface = boundary(guide, z == 2*Lw)
let xwalls: Surface = boundary(guide, x == 0 mm || x == a1 || ((x == x2 || x == x2 + a2) && z > Lw))
let ywalls: Surface = boundary(guide, y == 0 mm || y == b)
// The face of the step, at z = Lw outside the narrow guide.
let step_face: Surface = boundary(guide, z == Lw)

material air {
    eps: Current^2*Time/(Power*Length) = eps0
    mu: Power*Time/(Current^2*Length) = mu0
}

mesh m on guide {
    size: 1.4 mm
    cell: tet
}

// curl(curl(E)/mu) is written as div(Hs). Hs*n is n x (curl(E)/mu), the natural term of a port.
physics wave on guide solves E: Vector<Complex<Power/(Current*Length)>> {
    material air
    let Hs: Tensor2<Complex<Current/(Length*Time)>> = -2*skew(grad(E))/mu
    eq div(Hs) + eps*ddt2(E) = 0
}

method wave: cg { mesh: m, order: 1, family: nedelec }

// The walls are perfect conductors: the tangential components of E are zero.
bc xwalls: E.y = 0
bc xwalls: E.z = 0
bc ywalls: E.x = 0
bc ywalls: E.z = 0
bc step_face: E.x = 0
bc step_face: E.y = 0

// First-order TE10 port conditions. Port 1 has the incident wave e1.
bc port_in: Hs*n = im*beta1/mu0*(E - dot(E, n)*n) - 2*im*beta1/mu0*e1
bc port_out: Hs*n = im*beta2/mu0*(E - dot(E, n)*n)

step response: harmonic(freq: [f0]) {
    output E
}

// S21 takes the factor sqrt(a2*beta2/(a1*beta1)): the waves are normalized to 1 W.
expect s11_re: re(integral(dot(E, e1), port_in)/integral(dot(e1, e1), port_in) - 1) == 0.199629 within 0.035
expect s11_im: imag(integral(dot(E, e1), port_in)/integral(dot(e1, e1), port_in) - 1) == -0.304586 within 0.035
expect s21_re: re(integral(dot(E, e2), port_out)/integral(dot(e2, e2), port_out)*sqrt(a2*beta2/(a1*beta1))) == 0.737493 within 0.035
expect s21_im: imag(integral(dot(E, e2), port_out)/integral(dot(e2, e2), port_out)*sqrt(a2*beta2/(a1*beta1))) == 0.568202 within 0.035
