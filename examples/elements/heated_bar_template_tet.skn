// The heated bar of heated_bar_tet.skn with the bare heat template. The
// source is q_v of the material. The centre temperature is checked against
// the series of Timoshenko and Goodier (1970), section 109: 14.734270656 degC.

model heated_bar_template_tet: 3d, SI

let a: Length = 0.02 m
let lx: Length = 0.005 m

scales a, 100 K, 20 W/(m*K)

let bar: Solid = box((0, 0, 0) m, (lx, a, a))
let sides: Surface = boundary(bar, y == 0 m || y == a || z == 0 m || z == a)

material steel {
    k: Conductivity = 20 W/(m*K)
    q_v: Power/Volume = 1e7 W/m^3
}

mesh m on bar {
    size: 0.00125 m
    cell: tet
}

physics thermal on bar: heat solves T: Temperature {
    material steel
}

method thermal: cg { mesh: m, order: 2 }

step steady: static {
    bc sides: T = 0 degC
    output T
    report heat_out = reaction(sides)
}

// 0.1 % of the value in degC, as femahoy. A % in Skein is of the value in K, so the tolerance is absolute.
expect centre: T at (0.0025, 0.01, 0.01) m == 14.734270656 degC within 0.0147 K
