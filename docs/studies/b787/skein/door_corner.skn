// blocked-by: G3 N1
// Boeing 787 forward fuselage under cabin pressure: the door-corner
// submodel of the problem sheet (../problem.md, 6.4). A 0.600 m square
// panel of the x-s plane, centred on the centre of the upper aft corner
// radius of door 2. The cut edges take the displacement and the rotation
// of the global model (fuselage.skn).
// theta turns from +z to +y. A skin point is (x, R*sin(theta), R*cos(theta)).

model b787_door_corner: 3d, SI

let global: Results = results("fuselage.skn", step: "pressurize")

let R: Length = 2.883 m
let x_end: Length = 6.096 m
let f_pitch: Length = 0.6096 m
let p_U: Pressure = 1.5*65.0 kPa

// Door 2, a Type A exit (sheet 2.3), and the pad-up band around it (2.4).
let w_d: Length = 1.067 m
let h_d: Length = 1.829 m
let r_c: Length = 0.178 m
let theta_d: Angle = 75 deg
let pad_w: Length = 0.150 m

// T800S/3900 tape, RTA (sheet 1.2). nu12 is the assumption of the sheet.
let ply_E1: Pressure = 148 GPa
let ply_E2: Pressure = 10.1 GPa
let ply_G12: Pressure = 3.94 GPa
let ply_nu12: Real = 0.32
let ply_t: Length = 0.191 mm
let t_skin: Length = 24*ply_t

// Beam sections (sheet 4.2). The other section values are in the materials.
let A_s: Area = 2.016e-4 m^2
let A_f: Area = 7.148e-4 m^2

scales R, p_U

// Unit vectors at a skin point: axial, radial (outward) and hoop (theta).
let e_x: Vector<Real> = (1, 0, 0)
let e_r: Vector<Real> = (0, y/R, z/R)
let e_t: Vector<Real> = (0, z/R, -y/R)

// A panel of the barrel wall: x0 - a <= x <= x0 + a, and the arc +-b
// about the angle th. A box in the frame of the panel centre, turned about
// x. rotate turns by the right-hand rule, so -th takes +z to theta = th.
// The side faces cut the skin at theta = th +- b/R.
fn panel(x0: Length, a: Length, th: Angle, b: Length) -> Solid = rotate(
    box((x0 - a, -R*sin(b/R), R - 1 m), (x0 + a, R*sin(b/R), R + 1 m)),
    (1, 0, 0),
    -th,
)

// The door cutout grown by g in the x-s plane. The fillet of the radial
// edges of the panel gives the corner radius r_c + g. On the curved skin
// this is the nearest form of a corner radius in the x-s plane.
fn door_box(g: Length) -> Solid = fillet(panel(0 m, w_d/2 + g, theta_d, h_d/2 + g), r_c + g)

let barrel: Solid = cylinder((0, 0, 0) m, e_x, R, x_end)
let wall: Surface = boundary(barrel, y^2 + z^2 == R^2 && y >= 0 m)
// The panel of the submodel, about the centre of the corner radius.
let x_c: Length = w_d/2 - r_c
let s_c: Length = R*theta_d - h_d/2 + r_c
let sub: Solid = panel(x_c, 0.300 m, s_c/R, 0.300 m)
let skin: Surface = (wall & sub) - door_box(0 m)
let pad: Surface = skin & door_box(pad_w)
let plain: Surface = skin - door_box(pad_w)

// 90 stringers at theta = 2 deg + 4 deg*k, 45 on the left half. Frames at
// x = f_pitch/2 + f_pitch*k. The cutout cuts both (sheet 2.3).
let stringer_0: Curve = line((0 m, R*sin(2 deg), R*cos(2 deg)), (x_end, R*sin(2 deg), R*cos(2 deg)))
let left: Solid = box((0 m, 0 m, -2*R), (x_end, 2*R, 2*R))
let stringers: Curve = (pattern_polar(stringer_0, e_x, 90) & left & sub) - door_box(0 m)
let ring_0: Curve = boundary(wall, x == 0 m)
let frames: Curve = pattern(
    move(ring_0, (f_pitch/2, 0 m, 0 m)),
    (f_pitch, 0 m, 0 m),
    10,
) & sub - door_box(0 m)
let beams: Curve = stringers | frames

let cut: Curve = boundary(skin, sub)
let door_edge: Curve = boundary(skin, door_box(0 m))
// The aft part of the cutout edge in the panel: a part of the straight
// aft edge and of the upper aft corner arc (sheet 6.2).
let aft_of_x_c: Solid = box((x_c, 0 m, -2*R), (x_end, 2*R, 2*R))
let door_aft: Curve = door_edge & aft_of_x_c

// The mid-points of the cut edges that have skin (sheet 7.2, C6).
let Q_aft: Vector<Length> = (x_c + 0.300 m, R*sin(s_c/R), R*cos(s_c/R))
let Q_top: Vector<Length> = (x_c, R*sin((s_c - 0.300 m)/R), R*cos((s_c - 0.300 m)/R))
// The check point P of the global model (sheet 7.2), for K.
let P: Vector<Length> = (4.8768 m, R*sin(140 deg), R*cos(140 deg))

// Plies from the outer surface. The base sequence repeats, then mirrors,
// to the laminate thickness h of the material.
table quasi{angle: Angle in deg}:
    45
    0
    -45
    90

material skin_lam {
    E1: Pressure = ply_E1
    E2: Pressure = ply_E2
    G12: Pressure = ply_G12
    nu12: Real = ply_nu12
    t_ply: Length = ply_t
    h: Length = t_skin
}

material pad_lam {
    E1: Pressure = ply_E1
    E2: Pressure = ply_E2
    G12: Pressure = ply_G12
    nu12: Real = ply_nu12
    t_ply: Length = ply_t
    h: Length = 2*t_skin
}

// The quasi-isotropic in-plane values of the walls (sheet 3.3).
// y_axis of a section is radial, so I_z is the radial bending (sheet 4.2).
material stringer_sec {
    E: Pressure = 55.85 GPa
    nu: Real = 0.326
    A: Area = A_s
    I_y: Length^4 = 4.908e-8 m^4
    I_z: Length^4 = 3.639e-8 m^4
    J: Length^4 = 1.569e-10 m^4
    off: Length = 17.50 mm
}

material frame_sec {
    E: Pressure = 55.85 GPa
    nu: Real = 0.326
    A: Area = A_f
    I_y: Length^4 = 8.305e-8 m^4
    I_z: Length^4 = 2.237e-6 m^4
    J: Length^4 = 2.225e-9 m^4
    off: Length = 74.15 mm
}

mesh m on skin | beams {
    size: 20 mm
    cell: tri
    refine door_edge: 5 mm
}

// gap G3: no source of reissner_mindlin, and no layup. The template here
// takes the plies (layup, mirror), the ply 0 axis, the outer face and a
// load per area q. It gives the force resultant N (membrane and
// transverse shear) and the membrane strain eps_m.
// +45 deg turns from e_x to e_t, right-handed about e_r (sheet 3.1).
physics skin_shell on skin: reissner_mindlin(
    layup: quasi.angle,
    mirror: true,
    axis: e_x,
    top: e_r,
    q: p_U*e_r,
) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material skin_lam on plain, pad_lam on pad
    let e_hoop: Real = dot(e_t, eps_m*e_t)
    let e_axial: Real = dot(e_x, eps_m*e_x)
    let e_shear: Real = dot(e_x, eps_m*e_t)
    let e_1: Real = (e_axial + e_hoop)/2 + sqrt(((e_axial - e_hoop)/2)^2 + e_shear^2)
}

// gap N1: timoshenko(A, I_y, I_z) has no J, no section axis and no offset,
// and gives no axial force. The template here takes them and gives Nx.
physics beam on beams: timoshenko(
    A: A,
    I_y: I_y,
    I_z: I_z,
    J: J,
    y_axis: e_r,
    offset: -off*e_r,
) solves w_b: Vector<Length>,
    theta_b: Vector<Angle> {
    material stringer_sec on stringers, frame_sec on frames
}

method skin_shell: cg { mesh: m, order: 2 }

method beam: cg { mesh: m, order: 2 }

// The beams share the skin points on their lines, so the beam ends on
// the cut take the global values through the skin.
bc beams: w_b = w
bc beams: theta_b = theta
bc cut: w = global.w
bc cut: theta = global.theta

step pressurize: static {
    // The plug door load: p_U*x per unit s, so p_U*x*|n.x| per unit edge
    // length, because ds = |n.x|*dl.
    bc door_aft: N*n = p_U*x*abs(dot(n, e_x))*e_r
    output w, e_1, e_hoop
    // gap N2: max gives the value, not its point.
    report e_1_max = max(e_1, door_edge)
    report K = max(e_1, door_edge)/(global.e_hoop at P)
    report MS = 4000e-6/max(e_1, door_edge) - 1
}

expect c6_aft: e_hoop at Q_aft == global.e_hoop at Q_aft within 5%

expect c6_top: e_hoop at Q_top == global.e_hoop at Q_top within 5%
