// blocked-by: G32
// Boeing 787 forward fuselage under cabin pressure: the door-corner
// submodel of the problem sheet (../problem.md, 6.4). A 0.600 m square
// panel of the x-s plane, centred on the centre of the upper aft corner
// radius of door 2. The cut edges take the displacement and the rotation
// of the global model (fuselage.skn).

model b787_door_corner: 3d, SI

use "barrel.skn"

let global: Results = results("fuselage.skn", step: "pressurize")

scales R, p_U

// The panel of the submodel, about the centre of the corner radius.
let x_c: Length = w_d/2 - r_c
let s_c: Length = R*theta_d - h_d/2 + r_c
let sub: Solid = panel(x_c, 0.300 m, s_c/R, 0.300 m)
// gap G32: a Surface or a Curve & a Solid is a Solid in the checker, not
// the part of the Surface or the Curve in the Solid.
let skin: Surface = (wall & sub) - door_box(0 m)
let pad: Surface = skin & door_box(pad_w)
let plain: Surface = skin - door_box(pad_w)

// gap G32: the & left & sub gives a Solid.
let stringers: Curve = (pattern_polar(stringer_0, e_x, 90) & left & sub) - door_box(0 m)
// gap G32: the & sub gives a Solid.
let frames: Curve = pattern(
    move(ring_0, (f_pitch/2, 0 m, 0 m)),
    (f_pitch, 0 m, 0 m),
    10,
) & sub - door_box(0 m)
let beams: Curve = stringers | frames

let cut: Curve = boundary(skin, sub)
let door_edge: Curve = boundary(skin, door_box(0 m))
// The aft part of the cutout edge in the panel: a part of the straight
// aft edge and of the upper aft corner arc (sheet 6.2).
let aft_of_x_c: Solid = box((x_c, 0 m, -2*R), (x_end, 2*R, 2*R))
// gap G32: the & aft_of_x_c gives a Solid.
let door_aft: Curve = door_edge & aft_of_x_c

// The mid-points of the cut edges that have skin (sheet 7.2, C6).
let Q_aft: Vector<Length> = (x_c + 0.300 m, R*sin(s_c/R), R*cos(s_c/R))
let Q_top: Vector<Length> = (x_c, R*sin((s_c - 0.300 m)/R), R*cos((s_c - 0.300 m)/R))

// Plies from the outer surface. The base sequence repeats, then mirrors,
// to the laminate thickness h of the material.
table quasi{angle: Angle in deg}:
    45
    0
    -45
    90

mesh m on skin | beams {
    size: 20 mm
    cell: quad
    refine door_edge: 5 mm
}

// The shell template (spec 4.3) takes the plies (layup, mirror), the ply 0 axis, the outer face and a
// load per area q. It gives the force resultant N (membrane and
// transverse shear) and the membrane strain eps_m.
// +45 deg turns from e_x to e_t, right-handed about e_r (sheet 3.1).
physics skin_shell on skin: reissner_mindlin(
    layup: quasi.angle,
    mirror: true,
    axis: e_x,
    top: e_r,
    q: p_U*e_r,
) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material skin_lam on plain, pad_lam on pad
    let e_hoop: Real = dot(e_t, eps_m*e_t)
    let e_axial: Real = dot(e_x, eps_m*e_x)
    let e_shear: Real = dot(e_x, eps_m*e_t)
    let e_1: Real = (e_axial + e_hoop)/2 + sqrt(((e_axial - e_hoop)/2)^2 + e_shear^2)
}

// The beam template (spec 4.3) takes J, the section axis and the offset,
// and gives the axial force Nx.
physics beam on beams: timoshenko(
    A: A,
    I_y: I_y,
    I_z: I_z,
    J: J,
    y_axis: e_r,
    offset: -off*e_r,
) solves w_b: Vector<Length>,
    theta_b: Vector<Angle> {
    material stringer_sec on stringers, frame_sec on frames
}

method skin_shell: cg { mesh: m, order: 2 }

method beam: cg { mesh: m, order: 2 }

// The beams share the skin points on their lines, so the beam ends on
// the cut take the global values through the skin.
bc beams: w_b = w
bc beams: theta_b = theta
bc cut: w = global.w
bc cut: theta = global.theta

step pressurize: static {
    // The plug door load: p_U*x per unit s, so p_U*x*|n.x| per unit edge
    // length, because ds = |n.x|*dl.
    bc door_aft: N*n = p_U*x*abs(dot(n, e_x))*e_r
    output w, e_1, e_hoop
    report e_1_max = max(e_1, door_edge)
    report K = max(e_1, door_edge)/(global.e_hoop at P)
    report MS = 4000e-6/max(e_1, door_edge) - 1
}

expect c6_aft: e_hoop at Q_aft == global.e_hoop at Q_aft within 5%

expect c6_top: e_hoop at Q_top == global.e_hoop at Q_top within 5%
