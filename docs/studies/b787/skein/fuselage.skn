// blocked-by: G32
// Boeing 787 forward fuselage under cabin pressure: the global model of
// the problem sheet (../problem.md). One quarter of a 20-bay barrel,
// 0 <= x <= 6.096 m and 0 deg <= theta <= 180 deg, with the left door 2
// cutout. Composite skin shells, offset beams for the stringers and the
// frames, ultimate pressure and the end closure load.

model b787_fuselage: 3d, SI

use "barrel.skn"

let s_pitch: Length = 2*pi*R/90

scales R, p_U

let skin: Surface = wall - door_box(0 m)
// gap G32: a Surface or a Curve & a Solid is a Solid in the checker, not
// the part of the Surface or the Curve in the Solid.
let pad: Surface = skin & door_box(pad_w)
let plain: Surface = skin - door_box(pad_w)

// gap G32: the & left gives a Solid.
let stringers: Curve = (pattern_polar(stringer_0, e_x, 90) & left) - door_box(0 m)
let frames: Curve = pattern(
    move(ring_0, (f_pitch/2, 0 m, 0 m)),
    (f_pitch, 0 m, 0 m),
    10,
) - door_box(0 m)
let beams: Curve = stringers | frames

let skin_x0: Curve = boundary(skin, x == 0 m)
let skin_y0: Curve = boundary(skin, y == 0 m)
let skin_end: Curve = boundary(skin, x == x_end)
// The aft half of the cutout edge: the straight aft edge and the two aft
// corner arcs (sheet 6.2).
let aft_of_x_c: Solid = box((w_d/2 - r_c, 0 m, -2*R), (x_end, 2*R, 2*R))
// gap G32: the & aft_of_x_c gives a Solid.
let door_aft: Curve = boundary(skin, door_box(0 m)) & aft_of_x_c
let bottom: Point = point((0 m, 0 m, -R))

// Plies from the outer surface. The base sequence repeats, then mirrors,
// to the laminate thickness h of the material.
table quasi{angle: Angle in deg}:
    45
    0
    -45
    90

mesh m on skin | beams {
    size: 50 mm
    cell: quad
}

// The shell template (spec 4.3) takes the plies (layup, mirror), the ply 0 axis, the outer face and a
// load per area q. It gives the force resultant N (membrane and
// transverse shear) and the membrane strain eps_m.
// +45 deg turns from e_x to e_t, right-handed about e_r (sheet 3.1).
physics skin_shell on skin: reissner_mindlin(
    layup: quasi.angle,
    mirror: true,
    axis: e_x,
    top: e_r,
    q: p_U*e_r,
) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material skin_lam on plain, pad_lam on pad
    let s_axial: Pressure = dot(e_x, N*e_x)/h
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let e_hoop: Real = dot(e_t, eps_m*e_t)
}

// The beam template (spec 4.3) takes J, the section axis and the offset,
// and gives the axial force Nx.
physics beam on beams: timoshenko(
    A: A,
    I_y: I_y,
    I_z: I_z,
    J: J,
    y_axis: e_r,
    offset: -off*e_r,
) solves w_b: Vector<Length>,
    theta_b: Vector<Angle> {
    material stringer_sec on stringers, frame_sec on frames
}

method skin_shell: cg { mesh: m, order: 2 }

method beam: cg { mesh: m, order: 2 }

// A tie (spec 12.1): the beams share the skin points on their lines. The tie also
// gives the beam ends the symmetry conditions of the skin.
bc beams: w_b = w
bc beams: theta_b = theta
// Symmetry about x = 0 and y = 0, and one point against motion along z.
bc skin_x0: w.x = 0
bc skin_x0: theta.y = 0
bc skin_x0: theta.z = 0
bc skin_y0: w.y = 0
bc skin_y0: theta.x = 0
bc skin_y0: theta.z = 0
bc bottom: w.z = 0

step pressurize: static {
    // End closure load p_U*R/2, and the plug door load on the aft half
    // of the cutout edge. The sheet gives p_U*x per unit s. Per unit
    // edge length, this is p_U*x*|n.x|, because ds = |n.x|*dl.
    bc skin_end: N*n = (p_U*R/2, 0, 0)
    bc door_aft: N*n = p_U*x*abs(dot(n, e_x))*e_r
    output w, dot(w, e_r), s_hoop, s_axial, Nx
    report w_r_max = max(dot(w, e_r), skin)
    report stringer_max = max(Nx, stringers)
    report frame_max = max(Nx, frames)
    report reactions = reaction(skin_x0) + reaction(skin_y0) + reaction(bottom)
    report c1_ratio = s_hoop at P/(p_U*R/t_skin)
    report c2_ratio = s_axial at P/(p_U*R/(2*t_skin))
}

// Only skin_x0 takes x, only skin_y0 takes y and only bottom takes z.
let F_end: Force = p_U*pi*R^2/2
let s_hoop_lo: Pressure = p_U*R/(t_skin + A_f/f_pitch)
let s_hoop_hi: Pressure = p_U*R/t_skin

expect c1_hoop: s_hoop at P == (s_hoop_lo + s_hoop_hi)/2 within (s_hoop_hi - s_hoop_lo)/2

// Sheet 7.3: equal axial strain in skin and stringers, nu = 0.326.
expect c2_axial: s_axial at P ==
    (p_U*R/2 + 0.326*s_hoop_hi*A_s/s_pitch)/(t_skin + A_s/s_pitch) within 5%

expect c3_rx: (reaction(skin_x0)).x == -F_end within 0.1%

expect c4_rz: (reaction(bottom)).z == 0 N within F_end/1000

expect c5_ry: (reaction(skin_y0)).y == -p_U*2*R*x_end within 0.1%
