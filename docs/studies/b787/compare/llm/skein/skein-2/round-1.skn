// Boeing 787 forward fuselage barrel under ultimate cabin pressure.
// Quarter model: 0 <= x <= 6.096 m, 0 deg <= theta <= 180 deg (left side, +y).
// It has a Type A door cutout on the left side, and the door corner is refined.
//
// Limits of this model. Read these before you use the results.
// The Skein language card has no syntax for the features below, so this file
// does not model them:
//   1. Stringer and frame beams (sheet sections 4 and 7.1 item 3). The skin is
//      unstiffened. The hoop stress at P is then p_U*R/t = 61.3 MPa, at the top
//      of the C1 range. The axial stress at P is p_U*R/(2t) = 30.7 MPa. That is
//      7 % above the C2 value of 28.7 MPa, so expectation c2 is expected to FAIL.
//      No beam axial forces or frame hoop forces are reported.
//   2. Pad-up band around the door (section 2.4). One shell takes one laminate.
//      All skin, including the door surround, uses the 24-ply skin laminate.
//      The door-corner strain, K and MS are therefore conservative (high
//      strain, low margin).
//   3. Separate driven submodel (section 6.4). This file replaces it with local
//      mesh refinement of the global model in the same 0.6 m x 0.6 m region:
//      5 mm on the cutout edge and 20 mm in the region. A refined global model
//      is at least as accurate as a submodel. Items 5 to 7 come from this
//      region. The C6 values are reported, and they agree by construction.
//   4. The point of the maximum radial displacement and the point of the
//      maximum corner strain. No argmax function exists. Find these points in
//      the VTU output.
//
// Element choice: MITC4 quadrilateral shells, order 1. This is the shell
// element that skein run provides.

model fuselage787: 3d, SI

// ---------- Values (sheet sections 1 to 6) ----------
let R: Length = 2.883 m                 // skin mid-surface radius
let L: Length = 6.096 m                 // half barrel length (10 frame pitches)
let p_L: Pressure = 65.0 kPa            // limit cabin differential
param p_U: Pressure = 1.5*p_L in 65 kPa..130 kPa   // ultimate, 25.303

let t_skin: Length = 4.584 mm
let A_str: Area = 2.016e-4 m^2          // stringer area (for the checks only)
let A_frm: Area = 7.148e-4 m^2          // frame area (for the checks only)
let pitch_str: Length = 0.2013 m
let pitch_frm: Length = 0.6096 m

scales R, p_U

// Door cutout in the x-s plane: x <= 0.5334 m, s = 2.8593..4.6883 m,
// corner radius 0.178 m. The z values are R*cos(s/R).
let x_e: Length = 0.5334 m              // aft edge of the cutout
let rc: Length = 0.178 m                // corner radius
let x_c: Length = 0.3554 m              // x of the corner centres
let z_up: Length = 1.57758 m            // upper edge, theta = 56.83 deg
let z_lo: Length = -0.15962 m           // lower edge, theta = 93.17 deg
let z_up2: Length = 1.42568 m           // upper corner centre, theta = 60.362 deg
let z_lo2: Length = 0.018304 m          // lower corner centre, theta = 89.636 deg

// ---------- Geometry ----------
let tube: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, L)

let core1: Solid = box((-0.1 m, 0 m, z_lo), (x_c, R + 0.1 m, z_up))
let core2: Solid = box((-0.1 m, 0 m, z_lo2), (x_e, R + 0.1 m, z_up2))
// Corner cutters on the radial direction through each corner centre.
// Their bases are at radius R - 0.2 m, and they are 0.4 m long.
let c_up: Solid = cylinder((0.3554, 2.33198, 1.32678) m, (0, 0.869169, 0.494514), rc, 0.4 m)
let c_lo: Solid = cylinder((0.3554, 2.68295, 0.017034) m, (0, 0.99998, 0.006349), rc, 0.4 m)
let door_cut: Solid = core1 | core2 | c_up | c_lo
// Aft half of the cutout edge: the straight aft edge and the two aft corner arcs (x >= x_c)
let door_aft_cut: Solid = door_cut & box((x_c, 0 m, z_lo - 0.1 m), (x_e + 0.1 m, R + 0.1 m, z_up + 0.1 m))

let barrel: Solid = tube - door_cut
let wall: Surface = boundary(barrel, y^2 + z^2 == R^2 && y >= 0 m)

// Edges and points
let x0: Curve = boundary(wall, x == 0 m)              // symmetry plane x = 0
let ysym: Curve = boundary(wall, y == 0 m)            // theta = 0 and theta = 180 deg
let end: Curve = boundary(wall, x == L)               // closure end
let door_edge: Curve = boundary(wall, door_cut)
let door_aft: Curve = boundary(wall, door_aft_cut)
let bot: Point = point((0, 0, -R))                    // x = 0, theta = 180 deg

// Door-corner region: 0.6 m x 0.6 m around (x_c, s_c = 3.0373 m).
// x = 0.0554..0.6554 m, s = 2.7373..3.3373 m (z = 1.67825..1.15767 m).
let corner_patch: Surface = boundary(barrel, y^2 + z^2 == R^2 && y >= 0 m && x >= 0.0554 m && x <= 0.6554 m && z <= 1.67825 m && z >= 1.15767 m)
let corner_edge: Curve = boundary(corner_patch, door_cut)

// Check point P: x = 4.8768 m, theta = 140 deg
let P: Point = point((4.8768, 1.853158, -2.208505) m)
// C6 mid-points of the region edges that have skin
let C6_aft: Point = point((0.6554, 2.50581, 1.42568) m)   // x = 0.6554, s = 3.0373
let C6_top: Point = point((0.3554, 2.34418, 1.67825) m)   // x = 0.3554, s = 2.7373

// Local unit vectors: axial, hoop (increasing theta) and radial
let e_x: Vector<Real> = (1, 0, 0)
let e_t: Vector<Real> = (0, z/R, -y/R)
let e_r: Vector<Real> = (0, y/R, z/R)

// ---------- Laminate: skin [45/0/-45/90]3s, T800S/3900 RTA ----------
// The plies start at the outer face (top: n). The skin is quasi-isotropic,
// so the sign convention for ply angles does not change the membrane result.
table plies{angle: Angle in deg}:
    45
    0
    -45
    90

material ply {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 24*0.191 mm
}

// ---------- Mesh ----------
mesh m on wall {
    size: 50 mm
    cell: quad
    refine corner_patch: 20 mm
    refine corner_edge: 5 mm
}

// ---------- Physics: internal pressure p_U, outward on the mid-surface ----------
physics skin on wall: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: p_U*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material ply
    let w_r: Length = dot(e_r, w)
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let s_ax: Pressure = dot(e_x, N*e_x)/h
    let eps_h: Real = dot(e_t, eps_m*e_t)
    let eps_a: Real = dot(e_x, eps_m*e_x)
    let eps_xt: Real = dot(e_x, eps_m*e_t)
    let eps_p1: Real = (eps_a + eps_h)/2 + (((eps_a - eps_h)/2)^2 + eps_xt^2)^0.5
}

method skin: cg { mesh: m, order: 1 }

// ---------- Symmetry and rigid-body supports ----------
bc x0: w.x = 0
bc x0: theta.y = 0
bc x0: theta.z = 0
bc ysym: w.y = 0
bc ysym: theta.x = 0
bc ysym: theta.z = 0
bc bot: w.z = 0

// ---------- Analysis ----------
step pressurize: static {
    // End closure: p_U*R/2 = 140.5 kN/m along +x. The total is 1273.0 kN.
    bc end: N*n = (p_U*R/2, 0, 0)
    // Door load: p_U*x_e(s) per unit arc length in s, outward along the radius.
    // The side normal n points into the cutout. Then -n.x = ds/dl, which turns
    // the load per unit s into a load per unit edge length.
    bc door_aft: N*n = (0, -p_U*x*n.x*y/R, -p_U*x*n.x*z/R)

    output w, theta, w_r, s_hoop, s_ax, eps_h, eps_p1

    // 1. Radial displacement
    report w_r_max = max(w_r, wall)
    report w_r_min = min(w_r, wall)
    // 2. Membrane stresses
    report s_hoop_max = max(s_hoop, wall)
    report s_ax_max = max(s_ax, wall)
    // 4. Reaction sums
    report reaction(x0)
    report reaction(ysym)
    report reaction(bot)
    report rx_total = reaction(x0).x + reaction(ysym).x + reaction(bot).x
    report ry_total = reaction(x0).y + reaction(ysym).y + reaction(bot).y
    report rz_total = reaction(x0).z + reaction(ysym).z + reaction(bot).z
    // Resultant of the door load (sheet: 89.12 kN along +y and 23.88 kN along +z)
    report door_Fy = integral(-p_U*x*n.x*y/R, door_aft)
    report door_Fz = integral(-p_U*x*n.x*z/R, door_aft)

    // Checks C1 and C2 at P
    report C1_s_hoop_P = s_hoop at P
    report C1_ratio = (s_hoop at P)/(p_U*R/t_skin)
    report C1_lower = p_U*R/(t_skin + A_frm/pitch_frm)
    report C2_s_ax_P = s_ax at P
    report C2_ratio = (s_ax at P)/(p_U*R/(2*t_skin))
    report C2_expected = (p_U*R/2 + 0.326*(p_U*R/t_skin)*A_str/pitch_str)/(t_skin + A_str/pitch_str)

    // 5 to 7. Door corner (refined region in place of the submodel)
    report eps_hoop_P = eps_h at P
    report eps_p1_max_corner = max(eps_p1, corner_edge)
    report eps_p1_max_door = max(eps_p1, door_edge)
    report K = max(eps_p1, corner_edge)/(eps_h at P)
    report MS = 4000e-6/max(eps_p1, corner_edge) - 1

    // C6: hoop strain at the region edge mid-points (the same model, so they agree by construction)
    report C6_eps_h_aft = eps_h at C6_aft
    report C6_eps_h_top = eps_h at C6_top
}

// ---------- Built-in checks (sheet section 7.2) ----------
// C1: between 48.8 and 61.3 MPa. The centre is 55.05 MPa, and the half-width is 11.35 %.
expect c1_hoop: s_hoop at P == 55.05 MPa within 11.35%
// C2: 28.7 MPa within 5 %. This is expected to FAIL (about 30.7 MPa), because the model has no stringers.
expect c2_axial: s_ax at P == 28.7 MPa within 5%
expect c3_rx: reaction(x0).x + reaction(ysym).x + reaction(bot).x == -1273.0 kN within 0.1%
// C4: |sum of Rz| < 0.1 % of 1273.0 kN, written as a relative test on 1273 kN + Rz
expect c4_rz: 1273.0 kN + reaction(x0).z + reaction(ysym).z + reaction(bot).z == 1273.0 kN within 0.1%
expect c5_ry: reaction(x0).y + reaction(ysym).y + reaction(bot).y == -3427.1 kN within 0.1%
