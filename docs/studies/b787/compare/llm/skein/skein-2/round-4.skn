// Boeing 787 forward fuselage barrel under ultimate cabin pressure.
// Quarter model: 0 <= x <= 6.096 m, 0 deg <= theta <= 180 deg (left side, +y).
//
// Limits of this model. Read these before you use the results.
// The Skein language card cannot express the features below, so this file
// does not model them:
//   1. Door cutout, door edge load and door-corner submodel (sections 2.3,
//      2.4, 6.2 item 3, 6.4). A shell must be the side of a named cylinder,
//      selected by comparisons joined by &&, so the skin cannot have a hole.
//      Outputs 5, 6 and 7 (corner strain, K, MS) and check C6 are NOT produced.
//      The door load puts back the pressure that the cutout removes, so the
//      barrel without a door has the same reaction sums (C3 to C5).
//   2. Stringer and frame beams (section 4, output 3). The skin is unstiffened.
//      The hoop stress at P is then p_U*R/t = 61.3 MPa, at the top of the C1
//      range. The axial stress is p_U*R/(2t) = 30.7 MPa, 7 % above the C2
//      value of 28.7 MPa, so expectation c2 is expected to FAIL.
//   3. Pad-up band (section 2.4). It has no effect, because there is no door.
//   4. Maxima over the skin and arithmetic in reports are not available.
//      The maximum radial displacement and its point come from the VTU field
//      w_r. Compute the C1 and C2 ratios by hand from the reported values:
//        p_U*R/t      = 97.5 kPa * 2.883 m / 4.584 mm = 61.32 MPa (C1 upper, C1 ratio)
//        p_U*R/(t + A_frame/pitch) = 48.8 MPa                     (C1 lower)
//        p_U*R/(2t)   = 30.66 MPa                                 (C2 ratio)
//        C2 expected  = 28.7 MPa (sheet section 7.3)
//
// Element choice: MITC4 quadrilateral shells, order 1, size 50 mm.

model fuselage787: 3d, SI

// ---------- Values (sheet sections 1 to 6) ----------
let R: Length = 2.883 m                 // skin mid-surface radius
let L: Length = 6.096 m                 // half barrel length (10 frame pitches)
let p_L: Pressure = 65.0 kPa            // limit cabin differential
param p_U: Pressure = 1.5*p_L in 65 kPa..130 kPa   // ultimate, 25.303

scales R, p_U

// ---------- Geometry ----------
let tube: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, L)
let wall: Surface = boundary(tube, y^2 + z^2 == R^2 && y >= 0 m)

let x0: Curve = boundary(wall, x == 0 m)              // symmetry plane x = 0
let ysym: Curve = boundary(wall, y == 0 m)            // theta = 0 and theta = 180 deg
let end: Curve = boundary(wall, x == L)               // closure end
let bot: Point = point((0, 0, -R))                    // x = 0, theta = 180 deg

// Local unit vectors: axial, hoop (increasing theta) and radial
let e_x: Vector<Real> = (1, 0, 0)
let e_t: Vector<Real> = (0, z/R, -y/R)
let e_r: Vector<Real> = (0, y/R, z/R)

// ---------- Laminate: skin [45/0/-45/90]3s, T800S/3900 RTA ----------
// The plies start at the outer face (top: n). The skin is quasi-isotropic,
// so the sign convention for ply angles does not change the membrane result.
table plies{angle: Angle in deg}:
    45
    0
    -45
    90

material ply {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 24*0.191 mm
}

// ---------- Mesh ----------
mesh m on wall {
    size: 50 mm
    cell: quad
}

// ---------- Physics: internal pressure p_U, outward on the mid-surface ----------
physics skin on wall: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: p_U*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material ply
    let w_r: Length = dot(e_r, w)
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let s_ax: Pressure = dot(e_x, N*e_x)/h
    let eps_h: Real = dot(e_t, eps_m*e_t)
    let eps_a: Real = dot(e_x, eps_m*e_x)
}

method skin: cg { mesh: m, order: 1 }

// ---------- Symmetry and rigid-body supports ----------
bc x0: w.x = 0
bc x0: theta.y = 0
bc x0: theta.z = 0
bc ysym: w.y = 0
bc ysym: theta.x = 0
bc ysym: theta.z = 0
bc bot: w.z = 0

// ---------- Analysis ----------
step pressurize: static {
    // End closure: p_U*R/2 = 140.5 kN/m along +x. The total is 1273.0 kN.
    bc end: N*n = (p_U*R/2, 0, 0)

    output w, theta, w_r, s_hoop, s_ax, eps_h, eps_a

    // 1. Radial displacement (the full field is in the VTU output)
    report w_r_P = w_r at (4876.8, 1853.158, -2208.505) mm
    report w_r_side_x0 = w_r at (0, 2883, 0) mm
    report w_r_side_end = w_r at (6096, 2883, 0) mm
    report w_r_top_end = w_r at (6096, 0, 2883) mm
    // 2. Membrane stresses (C1 and C2) at P: x = 4.8768 m, theta = 140 deg
    report C1_s_hoop_P = s_hoop at (4876.8, 1853.158, -2208.505) mm
    report C2_s_ax_P = s_ax at (4876.8, 1853.158, -2208.505) mm
    report eps_hoop_P = eps_h at (4876.8, 1853.158, -2208.505) mm
    report eps_ax_P = eps_a at (4876.8, 1853.158, -2208.505) mm
    // 4. Reactions. x comes only from x0, y only from ysym, z only from bot.
    report reaction(x0)
    report reaction(ysym)
    report reaction(bot)
}

// ---------- Built-in checks (sheet section 7.2) ----------
// C1: between 48.8 and 61.3 MPa. The centre is 55.05 MPa, and the half-width is 11.35 %.
expect c1_hoop: s_hoop at (4876.8, 1853.158, -2208.505) mm == 55.05 MPa within 11.35%
// C2: 28.7 MPa within 5 %. This is expected to FAIL (about 30.7 MPa), because the model has no stringers.
expect c2_axial: s_ax at (4876.8, 1853.158, -2208.505) mm == 28.7 MPa within 5%
// C3: sum of x reactions = -1273.0 kN (only x0 restrains x)
expect c3_rx: reaction(x0).x == -1273.0 kN within 0.1%
// C5: sum of y reactions = -3427.1 kN (only ysym restrains y)
expect c5_ry: reaction(ysym).y == -3427.1 kN within 0.1%
// C4: the z reaction is only at bot. Check |reaction(bot).z| < 1.273 kN in the report.
// A relative tolerance cannot test a value of zero.
// C6 (submodel boundary) cannot be checked: there is no door model in Skein.
