// Boeing 787 forward fuselage barrel under cabin pressure: one quarter
// (0 <= x <= 6.096 m, 0 deg <= theta <= 180 deg), with the left passenger
// door (door 2, Type A) cutout and a skin pad-up around it.
//
// Deviations from the problem sheet, because the Skein card has no
// matching feature:
//  D1. No beam template. The stringers (90, theta = 2 + 4k deg) and the
//      frames (x = 0.3048 + 0.6096k m) are not in this model.
//      Section 4.2 data for a later beam model:
//        stringer: A 2.016e-4 m^2, offset 0.01750 m, I_r 3.639e-8 m^4,
//                  I_l 4.908e-8 m^4, J 1.569e-10 m^4
//        frame:    A 7.148e-4 m^2, offset 0.07415 m, I_r 2.237e-6 m^4,
//                  I_l 8.305e-8 m^4, J 2.225e-9 m^4
//        both:     E 55.85 GPa, nu 0.326
//      Because of this, C1 gives about p_U R / t (top of its range).
//      C2 gives about 30.7 MPa instead of 28.7 MPa, so C2 is expected to
//      FAIL. That failure shows the missing stringers.
//      Output item 3 (beam forces) is not available.
//  D2. No submodel feature. The door-corner submodel (section 6.4) is
//      replaced by local mesh refinement of the global model in the same
//      0.6 m x 0.6 m region: 5 mm on the cutout edge, 20 mm elsewhere.
//      The C6 values are reported at the region edge mid-points.
//  D3. The card shows one material for each shell. This model assigns the
//      skin and pad-up laminates to regions with "material NAME on
//      REGION". This form is not in the card.
//  D4. The door edge load is radial, so it is not in the plane of the
//      shell. This model gives it as a 3D edge force with N*n = (...). The
//      card shows this form only for in-plane loads.
//  D5. Skein has no inverse trigonometric functions.
//      - Straight edges at a fixed arc length s0 are tests on z. On y >= 0,
//        s increases as z decreases, so s >= s0 is z <= R*cos(s0/R). This
//        is exact.
//      - For corner arcs, ds is the arc length from the corner centre:
//        ds = R*asin(w/R), with w = y*cos(th_c) - z*sin(th_c) = R*sin(dth).
//        asin is evaluated as its series, w + w^3/(6R^2) + 3w^5/(40R^4).
//        The error is less than 0.005 mm for |ds| <= 0.328 m.
// Element order: MITC4 quadrilateral shells, order 1.

model fuselage787_door: 3d, SI

// ---- Loads (section 6.2) ----
param p_L: Pressure = 65.0 kPa in 10 kPa..100 kPa
let p_U: Pressure = 1.5*p_L

// ---- Barrel (section 2.2) ----
let R: Length = 2.883 m
let L: Length = 6.096 m
let t_skin: Length = 24*0.191 mm

scales R, p_U

// ---- Door cutout (section 2.3), in the x-s plane, s = R*theta ----
let xd: Length = 0.5334 m
let rc: Length = 0.178 m
let xc: Length = xd - rc
let s_up: Length = 2.8593 m
let s_lo: Length = 4.6883 m
let sc_up: Length = s_up + rc
let sc_lo: Length = s_lo - rc
let b_pad: Length = 0.150 m
let a_sub: Length = 0.300 m

// z values of the lines of constant arc length s = R*theta (exact on y >= 0)
let z_up: Length = R*cos(s_up/R)
let z_lo: Length = R*cos(s_lo/R)
let zc_up: Length = R*cos(sc_up/R)
let zc_lo: Length = R*cos(sc_lo/R)
let zb_up: Length = R*cos((s_up - b_pad)/R)
let zb_lo: Length = R*cos((s_lo + b_pad)/R)
let zs_top: Length = R*cos((sc_up - a_sub)/R)
let zs_bot: Length = R*cos((sc_up + a_sub)/R)

// Arc length from the upper corner centre (theta_u = sc_up/R)
let w_u: Length = y*cos(sc_up/R) - z*sin(sc_up/R)
let c_u: Length = z*cos(sc_up/R) + y*sin(sc_up/R)
let ds_u: Length = w_u + w_u^3/(6*R^2) + 3*w_u^5/(40*R^4)
// Arc length from the lower corner centre (theta_l = sc_lo/R)
let w_l: Length = y*cos(sc_lo/R) - z*sin(sc_lo/R)
let c_l: Length = z*cos(sc_lo/R) + y*sin(sc_lo/R)
let ds_l: Length = w_l + w_l^3/(6*R^2) + 3*w_l^5/(40*R^4)

// ---- Local directions on the skin ----
let e_x: Vector<Real> = (1, 0, 0)
let e_t: Vector<Real> = (0, z/R, -y/R)
let e_r: Vector<Real> = (0, y/R, z/R)

// ---- Geometry ----
let tube: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, L)
let side: Surface = boundary(tube, y^2 + z^2 == R^2 && y >= 0 m)
let door: Surface = boundary(tube, y^2 + z^2 == R^2 && y >= 0 m && ((x <= xc && z <= z_up && z >= z_lo) || (x <= xd && z <= zc_up && z >= zc_lo) || (c_u > 0 m && (x - xc)^2 + ds_u^2 <= rc^2) || (c_l > 0 m && (x - xc)^2 + ds_l^2 <= rc^2)))
let pad_band: Surface = boundary(tube, y^2 + z^2 == R^2 && y >= 0 m && ((x <= xc && z <= zb_up && z >= zb_lo) || (x <= xd + b_pad && z <= zc_up && z >= zc_lo) || (c_u > 0 m && (x - xc)^2 + ds_u^2 <= (rc + b_pad)^2) || (c_l > 0 m && (x - xc)^2 + ds_l^2 <= (rc + b_pad)^2)))
let wall: Surface = side - door
let pad: Surface = pad_band - door
let plain: Surface = wall - pad

// Upper aft door-corner region (the section 6.4 submodel region)
let zone: Surface = wall & boundary(tube, y^2 + z^2 == R^2 && y >= 0 m && x >= xc - a_sub && x <= xc + a_sub && z <= zs_top && z >= zs_bot)

// ---- Edges and points ----
let x0: Curve = boundary(wall, x == 0 m)
let x_end: Curve = boundary(wall, x == L)
let ysym: Curve = boundary(wall, y == 0 m)
let door_edge: Curve = boundary(wall, door)
let corner_edge: Curve = boundary(zone, door)
// Aft half of the cutout edge: the straight aft edge and the two aft corner arcs
let door_aft: Curve = boundary(wall, (x == xd && z <= zc_up && z >= zc_lo) || (x >= xc && z >= zc_up && c_u > 0 m && (x - xc)^2 + ds_u^2 == rc^2) || (x >= xc && z <= zc_lo && c_l > 0 m && (x - xc)^2 + ds_l^2 == rc^2))

let p_bot: Point = point((0 m, 0 m, -R))
let p_chk: Point = point((4.8768 m, R*sin(140 deg), R*cos(140 deg)))
let p_aft_mid: Point = point((xc + a_sub, R*sin(sc_up/R), R*cos(sc_up/R)))
let p_top_mid: Point = point((xc, R*sin((sc_up - a_sub)/R), R*cos((sc_up - a_sub)/R)))

// ---- Laminates (section 3): [45/0/-45/90]ns, from the outer face ----
table plies{angle: Angle in deg}:
    45
    0
    -45
    90

material skin_ply {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 24*0.191 mm
}

material pad_ply {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 48*0.191 mm
}

// ---- Mesh (sections 6.3 and 6.4) ----
mesh m on wall {
    size: 50 mm
    cell: quad
    refine zone: 20 mm
    refine corner_edge: 5 mm
}

// ---- Shell physics: internal pressure p_U, outward ----
physics skin on wall: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: p_U*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material skin_ply on plain
    material pad_ply on pad
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let s_axial: Pressure = dot(e_x, N*e_x)/h
    let eps_h: Real = dot(e_t, eps_m*e_t)
    let eps_a: Real = dot(e_x, eps_m*e_x)
    let eps_at: Real = dot(e_x, eps_m*e_t)
    let eps_1: Real = (eps_a + eps_h)/2 + sqrt(((eps_a - eps_h)/2)^2 + eps_at^2)
    let u_r: Length = dot(e_r, w)
}

method skin: cg { mesh: m, order: 1 }

// ---- Symmetry (section 5) ----
bc x0: w.x = 0
bc x0: theta.y = 0
bc x0: theta.z = 0
bc ysym: w.y = 0
bc ysym: theta.x = 0
bc ysym: theta.z = 0
bc p_bot: w.z = 0

// ---- Analysis ----
step pressurize: static {
    // End closure: p_U R / 2 = 140.5 kN/m along +x
    bc x_end: N*n = (p_U*R/2, 0, 0)
    // Door load: p_U * x_e per unit s, radial outward.
    // Per unit edge length this is p_U * x * ds/dl, with ds/dl = (x - xc)/rc
    // (equal to 1 on the straight aft edge).
    bc door_aft: N*n = p_U*x*(x - xc)/rc*e_r
    output w, theta, u_r, s_hoop, s_axial, eps_h, eps_a, eps_1

    // Output 1: radial displacement (the u_r field gives its location)
    report u_r_max = max(u_r, wall)
    // Output 2 and checks C1, C2 at P
    report hoop_P = s_hoop at p_chk
    report c1_ratio = (s_hoop at p_chk)/(p_U*R/t_skin)
    report axial_P = s_axial at p_chk
    report c2_ratio = (s_axial at p_chk)/(p_U*R/(2*t_skin))
    // Output 4 and checks C3, C4, C5
    report reaction(x0)
    report reaction(ysym)
    report reaction(p_bot)
    report rx_sum = reaction(x0).x
    report ry_sum = reaction(ysym).y
    report rz_sum = reaction(p_bot).z
    // Outputs 5 to 7: door corner (the refined region in place of a submodel)
    report eps1_max = max(eps_1, corner_edge)
    report eps_hoop_P = eps_h at p_chk
    report K = max(eps_1, corner_edge)/(eps_h at p_chk)
    report MS = 0.004/max(eps_1, corner_edge) - 1
    // Check C6: hoop strain at the mid-points of the region edges that have skin
    report c6_aft_mid = eps_h at p_aft_mid
    report c6_top_mid = eps_h at p_top_mid
}

// ---- Checks (section 7.2) ----
// C1: the range 48.8 to 61.3 MPa is the midpoint 55.05 MPa +/- 11.35 %
expect c1_hoop: s_hoop at p_chk == 55.05 MPa within 11.35%
// C2: this check is expected to FAIL without the stringers (see D1)
expect c2_axial: s_axial at p_chk == 28.7 MPa within 5%
expect c3_rx: reaction(x0).x == -1273.0 kN within 0.1%
expect c4_rz: reaction(p_bot).z == 0 N within 1.273 kN
expect c5_ry: reaction(ysym).y == -3427.1 kN within 0.1%
