// Boeing 787 forward fuselage pressurization: quarter barrel with door 2 cutout.
// Source: problem sheet, sections 2 to 7. Linear static, ultimate pressure p_U.
//
// Element order: MITC4 shells, order 1 (the only shell method in skein run).
//
// What this model does not include, because the Skein shell template cannot
// express it:
//   - Stringers and frames (sections 4, 7.1 item 3): Skein has no offset-beam
//     elements. The barrel is skin only. Check C1 should then sit at its upper
//     bound, p_U R / t. Check C2 is expected to give about 30.7 MPa, so it
//     should fail its 5 % band around 28.7 MPa.
//   - Pad-up band (section 2.4): one shell physics takes one laminate. The
//     whole skin uses the 24-ply skin laminate.
//   - Separate submodel (section 6.4) and check C6: skein run solves one mesh.
//     The global mesh is refined over the same 0.6 m x 0.6 m door-corner patch
//     instead: 20 mm inside the patch and 5 mm on the cutout edge. Outputs 5
//     to 7 come from that refined region.
//   - The location of each maximum: the report functions give values only.
//
// Geometry note: the door corners are radial cylinders of radius r_c that cut
// the skin. Their trace on the skin differs from a true circle in the x-s
// plane by about r_c^2/(2R), which is less than 6 mm.
// The z values below were found by hand from y = R sin(theta), z = R cos(theta).

model b787_fwd_fuselage: 3d, SI

// ---- Barrel, frames, stringers (section 2.2, 4.2) ----
let R: Length = 2.883 m
let L: Length = 6.096 m
let pitch_f: Length = 0.6096 m
let pitch_s: Length = 0.2013 m
let A_f: Area = 7.148e-4 m^2
let A_s: Area = 2.016e-4 m^2
let t_skin: Length = 24*0.191 mm
let nu_qi: Real = 0.326

// ---- Loads (section 6.2) ----
param pL: Pressure = 65.0 kPa in 10 kPa..100 kPa
let pU: Pressure = 1.5*pL

scales R, pU

// ---- Door cutout (section 2.3), quarter model x >= 0 ----
let a_d: Length = 0.5334 m
let r_c: Length = 0.178 m
let x_c: Length = a_d - r_c
// cutout upper edge theta = 56.826 deg, lower edge theta = 93.174 deg
let z_up: Length = 1.577552 m
let z_lo: Length = -0.159626 m
// corner-radius centres: theta = 60.363 deg (upper), 89.637 deg (lower)
let yc_up: Length = 2.505834 m
let zc_up: Length = 1.425652 m
let yc_lo: Length = 2.882942 m
let zc_lo: Length = 0.018266 m

let corner_up: Solid = cylinder((x_c, 0.8*yc_up, 0.8*zc_up), (0, yc_up/R, zc_up/R), r_c, 0.4*R)
let corner_lo: Solid = cylinder((x_c, 0.8*yc_lo, 0.8*zc_lo), (0, yc_lo/R, zc_lo/R), r_c, 0.4*R)
let door_core_h: Solid = box((-1 m, 0 m, z_lo), (x_c, R + 1 m, z_up))
let door_core_w: Solid = box((-1 m, 0 m, zc_lo), (a_d, R + 1 m, zc_up))
let door: Solid = door_core_h | door_core_w | corner_up | corner_lo

// ---- Skin surface: 0 <= x <= L, 0 <= theta <= 180 deg ----
let tube: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, L)
let skin: Surface = boundary(tube, y^2 + z^2 == R^2 && y >= 0 m) - door

let x0: Curve = boundary(skin, x == 0 m)
let y0: Curve = boundary(skin, y == 0 m)
let xend: Curve = boundary(skin, x == L)
let door_edge: Curve = boundary(skin, door)
let pbot: Point = point((0 m, 0 m, -R))

// ---- Door-corner patch (section 6.4) ----
// 0.6 m square centred on x_c = 0.3554 m, s_c = 3.0373 m:
// x from 0.0554 to 0.6554, s from 2.7373 to 3.3373 (z 1.678249 to 1.157692)
let corner_box: Solid = box((0.0554 m, 0 m, 1.157692 m), (0.6554 m, R + 1 m, 1.678249 m))
let corner_patch: Surface = skin & corner_box
let corner_edge: Curve = boundary(skin, door & corner_box)

// ---- Local directions ----
let e_x: Vector<Real> = (1, 0, 0)
let e_t: Vector<Real> = (0, z/R, -y/R)
let e_r: Vector<Real> = (0, y/R, z/R)

// ---- Check point P: x = 4.8768, theta = 140 deg ----
let P: Point = point((4.8768, 1.853158, -2.208506) m)

// ---- Laminate: skin [45/0/-45/90]3s, outer to inner (section 3.2) ----
table plies{angle: Angle in deg}:
    45
    0
    -45
    90

material ply_skin {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 24*0.191 mm
}

mesh m on skin {
    size: 50 mm
    cell: quad
    refine corner_patch: 20 mm
    refine door_edge: 5 mm
}

physics shell on skin: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: pU*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material ply_skin
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let s_axial: Pressure = dot(e_x, N*e_x)/h
    let u_r: Length = dot(w, e_r)
    let eps_x: Real = dot(e_x, eps_m*e_x)
    let eps_t: Real = dot(e_t, eps_m*e_t)
    let eps_xt: Real = dot(e_x, eps_m*e_t)
    let eps_1: Real = (eps_x + eps_t)/2 + (((eps_x - eps_t)/2)^2 + eps_xt^2)^0.5
}

method shell: cg { mesh: m, order: 1 }

// ---- Symmetry and support (section 5) ----
bc x0: w.x = 0
bc x0: theta.y = 0
bc x0: theta.z = 0
bc y0: w.y = 0
bc y0: theta.x = 0
bc y0: theta.z = 0
bc pbot: w.z = 0

// ---- Expected values (section 7.2) ----
let F_end: Force = pU*pi*R^2/2
let F_y: Force = pU*2*R*L
let s_h_hi: Pressure = pU*R/t_skin
let s_h_lo: Pressure = pU*R/(t_skin + A_f/pitch_f)
let s_x_c2: Pressure = (pU*R/2 + nu_qi*s_h_hi*A_s/pitch_s)/(t_skin + A_s/pitch_s)
let e_allow: Real = 4000e-6

step pressurize: static {
    // end closure load, p_U R / 2 per unit arc length
    bc xend: N*n = (pU*R/2, 0, 0)
    // door load: p_U x_e per unit s, radial. Per unit edge length this is
    // p_U x |n.x|, and n.x <= 0 on the aft half of the cutout edge.
    bc door_edge: N*n = pU*x*(-n.x)*e_r
    output w, theta, u_r, s_hoop, s_axial, eps_1
    // 1. radial displacement
    report max_u_r = max(u_r, skin)
    // 2. membrane stresses at P
    report hoop_P = s_hoop at P
    report c1_ratio = (s_hoop at P)/s_h_hi
    report axial_P = s_axial at P
    report c2_ratio = (s_axial at P)/(pU*R/(2*t_skin))
    // 4. reactions
    report reaction(x0)
    report reaction(y0)
    report reaction(pbot)
    report reaction_sum = reaction(x0) + reaction(y0) + reaction(pbot)
    // 5 to 7. door corner, refined region
    report eps1_max_corner = max(eps_1, corner_edge)
    report K = max(eps_1, corner_edge)/(eps_t at P)
    report MS = e_allow/max(eps_1, corner_edge) - 1
}

// C1: hoop stress at P inside [48.8, 61.3] MPa
expect c1_hoop: s_hoop at P == (s_h_lo + s_h_hi)/2 within (s_h_hi - s_h_lo)/2
// C2: axial stress at P, 28.7 MPa (expected to fail without stringers)
expect c2_axial: s_axial at P == s_x_c2 within 5%
// C3: sum of x reactions, -1273.0 kN
expect c3_rx: (reaction(x0) + reaction(y0) + reaction(pbot)).x == -F_end within 0.1%
// C4: sum of z reactions, near 0 (less than 0.1 % of 1273.0 kN)
expect c4_rz: (reaction(x0) + reaction(y0) + reaction(pbot)).z == 0 within 0.001*F_end
// C5: sum of y reactions, -3427.1 kN
expect c5_ry: (reaction(x0) + reaction(y0) + reaction(pbot)).y == -F_y within 0.1%
