// Boeing 787 forward fuselage, quarter barrel under ultimate cabin pressure,
// with the Type A door cutout (door 2, left side) and a refined door corner.
// Source: "Boeing 787 forward fuselage pressurization: problem sheet".
//
// Gaps against the sheet (features the Skein card does not define):
//  - Stringers and frames (offset beams, sec. 4) are not modelled. The skin
//    carries all load, so C1 reads near p_U R/t and C2 near 30.7 MPa (fails 5 %).
//  - Beam forces (output 3) cannot be reported.
//  - The door-corner submodel (sec. 6.4) is replaced by local refinement of
//    the global mesh: 5 mm on the cutout edge, 20 mm in the 0.6 m x 0.6 m square.
//    C6 has no submodel boundary and is not run.
//  - The location of a maximum cannot be reported, only its value.
// Element: MITC4 shell, order 1 (the writer's choice, sec. 6.3).

model fuselage_787: 3d, SI

// ---- Loads (sec. 6.2) ----
let p_L: Pressure = 65.0 kPa
param p_U: Pressure = 97.5 kPa in 50 kPa..150 kPa

// ---- Barrel (sec. 2.2, 5): quarter model, 0 <= x <= 6.096 m, 0 <= theta <= 180 deg ----
let R: Length = 2.883 m
let L: Length = 6.096 m

scales R, p_U

let tube: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, L)
let barrel: Surface = boundary(tube, y^2 + z^2 == R^2 && y >= 0 m)

// ---- Door cutout (sec. 2.3) ----
// x = +-0.5334 m; s = 2.8593 m (theta 56.83 deg) to 4.6883 m (theta 93.17 deg).
// On the skin y >= 0, so a theta range is a z range: z = R cos(theta).
// Corner radius 0.178 m; corner centres at x = +-0.3554 m, theta 60.362 deg and 89.636 deg.
let x_c: Length = 0.3554 m
let r_c: Length = 0.178 m
let door_wide: Solid = box((-0.5334, 0, 0.018316) m, (0.5334, 3.9, 1.425696) m)
let door_tall: Solid = box((-0.3554, 0, -0.159629) m, (0.3554, 3.9, 1.577572) m)
let door_c1: Solid = sphere((0.3554, 2.505809, 1.425696) m, r_c)
let door_c2: Solid = sphere((0.3554, 2.882942, 0.018316) m, r_c)
let door_c3: Solid = sphere((-0.3554, 2.505809, 1.425696) m, r_c)
let door_c4: Solid = sphere((-0.3554, 2.882942, 0.018316) m, r_c)
let door: Solid = door_wide | door_tall | door_c1 | door_c2 | door_c3 | door_c4

// ---- Pad-up band, 0.150 m around the cutout (sec. 2.4) ----
// x = +-0.6834 m; theta 53.844 deg to 96.155 deg; corner radius 0.328 m.
let pad_wide: Solid = box((-0.6834, 0, 0.018316) m, (0.6834, 3.9, 1.425696) m)
let pad_tall: Solid = box((-0.3554, 0, -0.309110) m, (0.3554, 3.9, 1.700928) m)
let pad_c1: Solid = sphere((0.3554, 2.505809, 1.425696) m, 0.3278 m)
let pad_c2: Solid = sphere((0.3554, 2.882942, 0.018316) m, 0.3278 m)
let pad_c3: Solid = sphere((-0.3554, 2.505809, 1.425696) m, 0.3278 m)
let pad_c4: Solid = sphere((-0.3554, 2.882942, 0.018316) m, 0.3278 m)
let pad_zone: Solid = pad_wide | pad_tall | pad_c1 | pad_c2 | pad_c3 | pad_c4

let pad: Surface = (barrel & pad_zone) - door
let skin: Surface = barrel - pad_zone
let wall: Surface = skin | pad

// ---- Door-corner refinement square (sec. 6.4) ----
// x = 0.0554 to 0.6554 m; s = 2.7373 to 3.3373 m (theta 54.40 to 66.325 deg).
let sub_box: Solid = box((0.0554, 0, 1.157663) m, (0.6554, 3.9, 1.678261) m)
let sub_square: Surface = wall & sub_box

// ---- Edges and points ----
let x0: Curve = boundary(wall, x == 0 m)
let ysym: Curve = boundary(wall, y == 0 m)
let x_end: Curve = boundary(wall, x == L)
let pin: Point = point((0 m, 0 m, -R))
let door_edge: Curve = boundary(wall, door)
// The aft half of the cutout edge: the straight aft edge and the two aft corner arcs.
let door_aft: Curve = door_edge & box((0.3554, 0, -0.5) m, (0.6, 3.9, 2.0) m)
// Check point P: x = 4.8768 m, theta = 140 deg.
let P: Point = point((4.8768, 1.853158, -2.208506) m)

// ---- Local directions ----
let e_x: Vector<Real> = (1, 0, 0)
let e_t: Vector<Real> = (0, z/R, -y/R)
let e_r: Vector<Real> = (0, y/R, z/R)

// ---- Plies and laminates (sec. 1.2, 3) ----
table plies{angle: Angle in deg}:
    45
    0
    -45
    90

// Skin [45/0/-45/90]3s, 24 plies, 4.584 mm
material ply_skin {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 24*0.191 mm
}

// Pad-up [45/0/-45/90]6s, 48 plies, 9.168 mm
material ply_pad {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 48*0.191 mm
}

// ---- Mesh (sec. 6.3, 6.4) ----
// 50.8 mm = frame pitch / 12, so frame lines and P can fall on nodes.
mesh m on wall {
    size: 50.8 mm
    cell: quad
    refine sub_square: 20 mm
    refine door_edge: 5 mm
}

// ---- Shells ----
// q: internal pressure, outward on the mid-surface. The cutout carries no pressure.
physics shell_skin on skin: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: p_U*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material ply_skin
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let s_axial: Pressure = dot(e_x, N*e_x)/h
    let eps_hoop: Real = dot(e_t, eps_m*e_t)
}

physics shell_pad on pad: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: p_U*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material ply_pad
    let s_hoop_pad: Pressure = dot(e_t, N*e_t)/h
    let s_axial_pad: Pressure = dot(e_x, N*e_x)/h
    let ea: Real = dot(e_x, eps_m*e_x)
    let eh: Real = dot(e_t, eps_m*e_t)
    let eah: Real = dot(e_x, eps_m*e_t)
    // Maximum principal membrane strain
    let eps1: Real = (ea + eh)/2 + (((ea - eh)/2)^2 + eah^2)^0.5
}

method shell_skin: cg { mesh: m, order: 1 }
method shell_pad: cg { mesh: m, order: 1 }

let w_r: Length = dot(e_r, w)

// ---- Symmetry (sec. 5) ----
bc x0: w.x = 0
bc x0: theta.y = 0
bc x0: theta.z = 0
bc ysym: w.y = 0
bc ysym: theta.x = 0
bc ysym: theta.z = 0
bc pin: w.z = 0

// ---- Edge loads (sec. 6.2) ----
// End closure: p_U R / 2 = 140.5 kN/m along +x.
let f_end: Force/Length = p_U*R/2
// Door load: p_U x_e per unit s, radial. Per unit edge length this is
// p_U x (x - x_c)/r_c, which is 52.01 kN/m on the straight aft edge.
let q_door: Force/Length = p_U*x*(x - x_c)/r_c

step pressurize: static {
    bc x_end: N*n = (f_end, 0 N/m, 0 N/m)
    bc door_aft: N*n = (0 N/m, q_door*y/R, q_door*z/R)
    output w, w_r, s_hoop, s_axial, s_hoop_pad, s_axial_pad, eps1

    // Output 1: radial displacement
    report w_r_max = max(w_r, wall)
    report w_r_min = min(w_r, wall)
    // Output 2: membrane stresses
    report s_hoop_max_skin = max(s_hoop, skin)
    report s_hoop_max_pad = max(s_hoop_pad, pad)
    report s_axial_max_skin = max(s_axial, skin)
    report s_hoop_P = s_hoop at P
    report s_axial_P = s_axial at P
    report C1_ratio = (s_hoop at P)/(p_U*R/(24*0.191 mm))
    report C2_ratio = (s_axial at P)/(p_U*R/(2*24*0.191 mm))
    // Output 4: reactions
    report R_x0 = reaction(x0)
    report R_ysym = reaction(ysym)
    report R_pin = reaction(pin)
    report R_sum = reaction(x0) + reaction(ysym) + reaction(pin)
    // Outputs 5 to 7: door corner (refined region in place of the submodel)
    report eps1_edge_max = max(eps1, door_edge)
    report eps_hoop_P = eps_hoop at P
    report K = max(eps1, door_edge)/(eps_hoop at P)
    report MS = 0.004/max(eps1, door_edge) - 1
}

// ---- Checks (sec. 7.2) ----
// C1: 48.8 MPa to 61.3 MPa
expect c1: s_hoop at P == 55.05 MPa within 6.25 MPa
// C2: 28.7 MPa (expected to fail without stringers: about 30.7 MPa)
expect c2: s_axial at P == 28.7 MPa within 5%
// C3: sum of x reactions
expect c3: (reaction(x0) + reaction(ysym) + reaction(pin)).x == -1273.0 kN within 0.1%
// C4: sum of z reactions, within 0.1 % of 1273.0 kN
expect c4: (reaction(x0) + reaction(ysym) + reaction(pin)).z == 0 kN within 1.273 kN
// C5: sum of y reactions
expect c5: (reaction(x0) + reaction(ysym) + reaction(pin)).y == -3427.1 kN within 0.1%
// C6: no separate submodel, so there is no boundary to compare.
