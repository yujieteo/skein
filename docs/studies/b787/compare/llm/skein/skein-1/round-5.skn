// Boeing 787 forward fuselage, quarter barrel under ultimate cabin pressure,
// with the Type A door cutout (door 2, left side) and a refined door corner.
// Source: "Boeing 787 forward fuselage pressurization: problem sheet".
//
// Gaps against the sheet (features the Skein card does not define):
//  - Stringers and frames (offset beams, sec. 4) are not modelled. The skin
//    carries all load, so C1 reads near p_U R/t and C2 near 30.7 MPa (fails 5 %).
//  - Beam forces (output 3) cannot be reported.
//  - Pad-up laminate (sec. 2.4): one shell physics holds one laminate, so the
//    skin laminate [45/0/-45/90]3s is used everywhere. Corner strains are too high.
//  - Door corner radius 0.178 m (sec. 2.3): a shell piece can only be cut in theta,
//    so the cutout is a rectangle with square corners. The corner strain is
//    singular: eps1_edge_max, K and MS depend on the mesh. The strain at the
//    middle of the aft edge is reported as a value that does not.
//  - The door-corner submodel (sec. 6.4) is replaced by local refinement of
//    the global mesh: 5 mm on the cutout edge, 20 mm near the corner.
//    C6 has no submodel boundary and is not run.
//  - The location of a maximum cannot be reported, only its value.
// Element: MITC4 shell, order 1 (the writer's choice, sec. 6.3).

model fuselage_787: 3d, SI

// ---- Loads (sec. 6.2) ----
let p_L: Pressure = 65.0 kPa
param p_U: Pressure = 97.5 kPa in 50 kPa..150 kPa

// ---- Barrel (sec. 2.2, 5): quarter model, 0 <= x <= 6.096 m, 0 <= theta <= 180 deg ----
let R: Length = 2.883 m
let L: Length = 6.096 m

scales R, p_U

// ---- Door cutout (sec. 2.3), square corners ----
// x = +-0.5334 m; s = 2.8593 m (theta 56.83 deg, z 1.577572) to 4.6883 m (theta 93.17 deg, z -0.159629).
// On the skin y >= 0, so a theta range is a z range: z = R cos(theta).
let x_d: Length = 0.5334 m
let door: Solid = box((-0.5334, 0, -0.159629) m, (0.5334, 3.9, 1.577572) m)

// ---- Skin: half barrel minus the cutout, as three pieces ----
// Aft of the door: x = 0.5334 to 6.096 m, theta 0 to 180 deg
let cyl_aft: Solid = cylinder((0.5334, 0, 0) m, (1, 0, 0), R, L - x_d)
let sk_aft: Surface = boundary(cyl_aft, y^2 + z^2 == R^2 && y >= 0 m)
// Beside the door: x = 0 to 0.5334 m
let cyl_door: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, x_d)
// Above the door (theta 0 to 56.83 deg)
let sk_top: Surface = boundary(cyl_door, y^2 + z^2 == R^2 && y >= 0 m && z >= 1.577572 m)
// Below the door (theta 93.17 to 180 deg)
let sk_bot: Surface = boundary(cyl_door, y^2 + z^2 == R^2 && y >= 0 m && z <= -0.159629 m)
let wall: Surface = sk_aft | sk_top | sk_bot

// ---- Refinement regions (sec. 2.4, 6.4) ----
// Pad-up band bounds: x <= 0.6834 m, theta 53.844 to 96.155 deg.
let cyl_pad: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, 0.6834 m)
let pad: Surface = boundary(cyl_pad, y^2 + z^2 == R^2 && y >= 0 m && z >= -0.309110 m && z <= 1.700928 m)
// Corner square: x = 0.0554 to 0.6554 m; s = 2.7373 to 3.3373 m (theta 54.40 to 66.325 deg).
let cyl_sub: Solid = cylinder((0.0554, 0, 0) m, (1, 0, 0), R, 0.6 m)
let sub_square: Surface = boundary(cyl_sub, y^2 + z^2 == R^2 && y >= 0 m && z >= 1.157663 m && z <= 1.678261 m)

// ---- Edges and points ----
let x0: Curve = boundary(wall, x == 0 m)
let ysym: Curve = boundary(wall, y == 0 m)
let x_end: Curve = boundary(wall, x == L)
let pin: Point = point((0 m, 0 m, -R))
let door_edge: Curve = boundary(wall, door)
// The aft half of the cutout edge in the quarter model: the straight aft edge.
let door_aft: Curve = boundary(wall, x == 0.5334 m)
// Check point P: x = 4.8768 m, theta = 140 deg.
let P: Point = point((4.8768, 1.853158, -2.208506) m)
// Middle of the aft door edge: x = 0.5334 m, theta = 75 deg.
let Q: Point = point((0.5334, 2.784765, 0.746175) m)

// ---- Local directions ----
let e_x: Vector<Real> = (1, 0, 0)
let e_t: Vector<Real> = (0, z/R, -y/R)
let e_r: Vector<Real> = (0, y/R, z/R)

// ---- Plies and laminate (sec. 1.2, 3) ----
table plies{angle: Angle in deg}:
    45
    0
    -45
    90

// Skin [45/0/-45/90]3s, 24 plies, 4.584 mm
material ply_skin {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 24*0.191 mm
}

// ---- Mesh (sec. 6.3, 6.4) ----
// 50.8 mm = frame pitch / 12, so frame lines and P can fall on nodes.
mesh m on wall {
    size: 50.8 mm
    cell: quad
    refine pad: 20 mm
    refine sub_square: 20 mm
    refine door_edge: 5 mm
}

// ---- Shell ----
// q: internal pressure, outward on the mid-surface. The cutout carries no pressure.
physics skin on wall: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: p_U*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material ply_skin
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let s_axial: Pressure = dot(e_x, N*e_x)/h
    let eps_hoop: Real = dot(e_t, eps_m*e_t)
    let eps_ax: Real = dot(e_x, eps_m*e_x)
    let eps_xt: Real = dot(e_x, eps_m*e_t)
    // Maximum principal membrane strain
    let eps1: Real = (eps_ax + eps_hoop)/2 + (((eps_ax - eps_hoop)/2)^2 + eps_xt^2)^0.5
}

method skin: cg { mesh: m, order: 1 }

let w_r: Length = dot(e_r, w)

// ---- Symmetry (sec. 5) ----
bc x0: w.x = 0
bc x0: theta.y = 0
bc x0: theta.z = 0
bc ysym: w.y = 0
bc ysym: theta.x = 0
bc ysym: theta.z = 0
bc pin: w.z = 0

// ---- Edge loads (sec. 6.2) ----
// End closure: p_U R / 2 = 140.5 kN/m along +x.
let f_end: Force/Length = p_U*R/2
// Door load: p_U x_e per unit s, radial; p_U * 0.5334 m = 52.01 kN/m on the aft edge.
let q_door: Force/Length = p_U*x_d

step pressurize: static {
    bc x_end: N*n = (f_end, 0 N/m, 0 N/m)
    bc door_aft: N*n = (0 N/m, q_door*y/R, q_door*z/R)
    output w, w_r, s_hoop, s_axial, eps1

    // Output 1: radial displacement
    report w_r_max = max(w_r, wall)
    report w_r_min = min(w_r, wall)
    // Output 2: membrane stresses
    report s_hoop_max = max(s_hoop, wall)
    report s_axial_max = max(s_axial, wall)
    report s_hoop_P = s_hoop at P
    report s_axial_P = s_axial at P
    report C1_ratio = (s_hoop at P)/(p_U*R/(24*0.191 mm))
    report C2_ratio = (s_axial at P)/(p_U*R/(2*24*0.191 mm))
    // Output 4: reactions
    report R_x0 = reaction(x0)
    report R_ysym = reaction(ysym)
    report R_pin = reaction(pin)
    report R_sum = reaction(x0) + reaction(ysym) + reaction(pin)
    // Outputs 5 to 7: door edge (refined region in place of the submodel).
    // The maximum is at a square corner and depends on the mesh.
    report eps1_edge_max = max(eps1, door_edge)
    report eps_hoop_P = eps_hoop at P
    report K = max(eps1, door_edge)/(eps_hoop at P)
    report MS = 0.004/max(eps1, door_edge) - 1
    // Mesh-independent edge value: middle of the aft door edge
    report eps1_Q = eps1 at Q
    report K_Q = (eps1 at Q)/(eps_hoop at P)
}

// ---- Checks (sec. 7.2) ----
// C1: 48.8 MPa to 61.3 MPa
expect c1: s_hoop at P == 55.05 MPa within 6.25 MPa
// C2: 28.7 MPa (expected to fail without stringers: about 30.7 MPa)
expect c2: s_axial at P == 28.7 MPa within 5%
// C3: sum of x reactions
expect c3: (reaction(x0) + reaction(ysym) + reaction(pin)).x == -1273.0 kN within 0.1%
// C4: sum of z reactions, within 0.1 % of 1273.0 kN
expect c4: (reaction(x0) + reaction(ysym) + reaction(pin)).z == 0 kN within 1.273 kN
// C5: sum of y reactions
expect c5: (reaction(x0) + reaction(ysym) + reaction(pin)).y == -3427.1 kN within 0.1%
// C6: no separate submodel, so there is no boundary to compare.
