// Boeing 787 forward fuselage pressurization: quarter barrel, 0 <= theta <= 180 deg.
// Source: problem sheet, sections 2 to 7. Linear static, ultimate pressure p_U.
//
// Element order: MITC4 shells, order 1 (the only shell method in skein run).
//
// What this model does not include, because this slice of skein run cannot
// express it:
//   - Door cutout (section 2.3) and door load (section 6.2 item 3): the shell
//     must be a plain part of the side of a cylinder, so the skin cannot have
//     a hole. The door's pressure acts on the skin where the door would be,
//     so the pressure resultants still match the sheet.
//   - Door-corner submodel (section 6.4), outputs 5 to 7 and check C6: these
//     need the cutout.
//   - Stringers and frames (sections 4, 7.1 item 3): no offset-beam elements.
//     The barrel is skin only. Check C1 should then sit at its upper bound,
//     p_U R / t. Check C2 is expected to give about 30.7 MPa, so it should
//     fail its 5 % band around 28.7 MPa.
//   - Pad-up band (section 2.4): one laminate per shell, and no cutout.
//   - Maximum over the skin, sums of reactions, and the radial displacement
//     as a field: reports can only be a value at a point or reaction(region).
//     Work these out by hand from the reports:
//       radial displacement at P: u_r = 0.642788 w.y - 0.766044 w.z
//       C3  sum of x reactions = -1273.0 kN  (within 0.1 %)
//       C4  sum of z reactions = 0           (|sum| < 1.273 kN)
//       C5  sum of y reactions = -3427.1 kN  (within 0.1 %)
//
// Check point P: x = 4.8768 m, theta = 140 deg
//   y = R sin(140 deg) = 1.853158 m, z = R cos(140 deg) = -2.208506 m

model b787_fwd_fuselage: 3d, SI

// ---- Barrel (section 2.2) ----
let R: Length = 2.883 m
let L: Length = 6.096 m

// ---- Loads (section 6.2) ----
param pL: Pressure = 65.0 kPa in 10 kPa..100 kPa
let pU: Pressure = 1.5*pL

scales R, pU

// ---- Skin surface: 0 <= x <= L, left half (y >= 0) ----
let tube: Solid = cylinder((0, 0, 0) m, (1, 0, 0), R, L)
let skin: Surface = boundary(tube, y^2 + z^2 == R^2 && y >= 0 m)

let x0: Curve = boundary(skin, x == 0 m)
let y0: Curve = boundary(skin, y == 0 m)
let xend: Curve = boundary(skin, x == L)
let pbot: Point = point((0 m, 0 m, -R))

// ---- Local directions ----
let e_x: Vector<Real> = (1, 0, 0)
let e_t: Vector<Real> = (0, z/R, -y/R)

// ---- Laminate: skin [45/0/-45/90]3s, outer to inner (section 3.2) ----
table plies{angle: Angle in deg}:
    45
    0
    -45
    90

material ply_skin {
    E1: Pressure = 148 GPa
    E2: Pressure = 10.1 GPa
    G12: Pressure = 3.94 GPa
    nu12: Real = 0.32
    t_ply: Length = 0.191 mm
    h: Length = 24*0.191 mm
}

mesh m on skin {
    size: 50 mm
    cell: quad
}

physics skin_shell on skin: reissner_mindlin(layup: plies.angle, mirror: true, top: n, q: pU*n) solves w: Vector<Length>,
    theta: Vector<Angle> {
    material ply_skin
    let s_hoop: Pressure = dot(e_t, N*e_t)/h
    let s_axial: Pressure = dot(e_x, N*e_x)/h
    let eps_t: Real = dot(e_t, eps_m*e_t)
}

method skin_shell: cg { mesh: m, order: 1 }

// ---- Symmetry and support (section 5) ----
bc x0: w.x = 0
bc x0: theta.y = 0
bc x0: theta.z = 0
bc y0: w.y = 0
bc y0: theta.x = 0
bc y0: theta.z = 0
bc pbot: w.z = 0

step pressurize: static {
    // end closure load, p_U R / 2 per unit arc length
    bc xend: N*n = (pU*R/2, 0, 0)
    output w, theta, s_hoop, s_axial
    // 1. displacement at P (u_r = 0.642788 w.y - 0.766044 w.z)
    report wy_P = w.y at (4876.8, 1853.158, -2208.506) mm
    report wz_P = w.z at (4876.8, 1853.158, -2208.506) mm
    // 2. membrane stresses at P (C1 ratio = hoop / 61.32 MPa,
    //    C2 ratio = axial / 30.66 MPa)
    report hoop_P = s_hoop at (4876.8, 1853.158, -2208.506) mm
    report axial_P = s_axial at (4876.8, 1853.158, -2208.506) mm
    report hoop_strain_P = eps_t at (4876.8, 1853.158, -2208.506) mm
    // 4. reactions, summed by hand for C3 to C5
    report reaction(x0)
    report reaction(y0)
    report reaction(pbot)
}

// C1: hoop stress at P inside [48.83, 61.32] MPa (midpoint 55.08 MPa)
expect c1_hoop: s_hoop at (4876.8, 1853.158, -2208.506) mm == 55.08 MPa within 11.3%
// C2: axial stress at P, 28.7 MPa (expected to fail without stringers)
expect c2_axial: s_axial at (4876.8, 1853.158, -2208.506) mm == 28.7 MPa within 5%
