+def window_edges(mesh):
+    """The aft and fore half of each window edge, each in the order of s as
+    in door_edge, with the window centre x."""
+    out = []
+    for c in CUTOUTS[1:]:
+        x0, s0 = c[0], c[1]
+        nodes = mesh.nodes_where(lambda x, s: abs(box_distance(x, s, c)) < 1e-6)
+        for side in (1.0, -1.0):
+            half = [n for n in nodes if (mesh.xy[n][0] - x0) * side >= -1e-9]
+            out.append((x0, sorted(half, key=lambda n: (
+                mesh.xy[n][1], abs(mesh.xy[n][0] - x0) * (1 if mesh.xy[n][1] < s0 else -1)))))
+    return out
