! Reference deck for LLM test 04 (written for this test, not run).
! Submodel of the hole in deck 01: block x 25..55, z 5..35, cut-boundary
! displacements from the coarse model by CBDOF. Run deck 01 first with
! /FILNAME,coarse so that coarse.rst and coarse.db exist. Units: mm, N, MPa.
/FILNAME,sub
/PREP7
ET,1,SOLID187
MP,EX,1,210000
MP,PRXY,1,0.3
BLOCK,25,55,0,20,5,35
WPROTA,0,-90,0
CYL4,40,-20,6,,,,20
WPCSYS,-1,0
VSBV,1,2
ESIZE,1.5
LSEL,S,RADIUS,,6
LESIZE,ALL,0.25
ALLSEL
VMESH,ALL
NSEL,S,LOC,X,25
NSEL,A,LOC,X,55
NSEL,A,LOC,Z,5
NSEL,A,LOC,Z,35
NWRITE,cut,node
ALLSEL
FINISH
/CLEAR,NOSTART
RESUME,coarse,db
/POST1
FILE,coarse,rst
CBDOF,cut,node,,cut,cbdo
FINISH
/CLEAR,NOSTART
RESUME,sub,db
/SOLU
ANTYPE,STATIC
/INPUT,cut,cbdo
SOLVE
FINISH
/POST1
NSEL,S,LOC,X,25,55
PLNSOL,S,EQV
FINISH
