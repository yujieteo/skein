! Reference deck for LLM test 01 (written for this test, not run).
! Cantilever 200 x 20 x 40 mm with a 6 mm radius hole along Y at x = 40, z = 20.
! Fixed at x = 0, 2 kN downward load at x = 200. Units: mm, N, MPa.
/PREP7
ET,1,SOLID187
MP,EX,1,210000
MP,PRXY,1,0.3
BLOCK,0,200,0,20,0,40
WPROTA,0,-90,0              ! working plane Z along global +Y
CYL4,40,-20,6,,,,20         ! WP y = -global z
WPCSYS,-1,0
VSBV,1,2
ESIZE,5
LSEL,S,RADIUS,,6
LESIZE,ALL,1
ALLSEL
MSHAPE,1,3D
MSHKEY,0
VMESH,ALL
ASEL,S,LOC,X,0
DA,ALL,ALL,0
ALLSEL
NSEL,S,LOC,X,200
*GET,NTIP,NODE,0,COUNT
F,ALL,FZ,-2000/NTIP         ! uniform nodal forces, not a uniform traction
ALLSEL
FINISH
/SOLU
ANTYPE,STATIC
SOLVE
FINISH
/POST1
NSEL,S,LOC,X,0
PRRSOL,FZ
ALLSEL
PLNSOL,S,EQV
FINISH
