// The shared types of the finite element runtime: the unstructured mesh,
// the named node and face sets, and the element registry.
//
// A mesher fills the mesh with `mesh_clear`, `add_node`, `add_cell`,
// `add_node_set` and `add_face_set`. The box mesher (mesh.goose) is the
// first one. The assembly (solve.goose) reads the mesh only through these
// arrays and the registry, so it does not know which mesher made the mesh.
//
// The registry gives for each cell type: the number of nodes, the
// dimension, the shape functions, the quadrature and the element routine.
// A cell type that has no entry gives false, and the caller reports it.
// Each lane of phase 2 has one file for its entries (lane_*.goose), so
// that the lanes add code there and do not edit this file.
import std;
namespace runtime;
import .solid;
import .hex8i;
import .lane_elements;
import .lane_shells;

// --- cell types ------------------------------------------------------------------

// The node order of each cell type is the order of its registry entry.
let TRI3 = 0;
let TRI6 = 1;
let TET4 = 2;
let TET10 = 3;
let HEX8 = 4;
let HEX27 = 5;
let QUAD4_SHELL = 6;
let BEAM2 = 7;
let HEX8I = 8;     // hex8 with incompatible modes (hex8i.goose)

let CELL_NAMES = ["tri3", "tri6", "tet4", "tet10", "hex8", "hex27", "quad4_shell", "beam2", "hex8i"];
let CELL_NODES: i64[9] = [3, 6, 4, 10, 8, 27, 4, 2, 8];
let CELL_DIMS: i64[9] = [2, 2, 3, 3, 3, 3, 2, 1, 3];

// --- the mesh ----------------------------------------------------------------------

var coords: f64[>..] = [];          // x, y and z of each node
var cell_type: u8[>..] = [];        // the cell type of each cell
var cell_start: i64[>..] = [0];     // the nodes of cell c are cell_nodes[cell_start[c]..cell_start[c + 1]]
var cell_nodes: i64[>..] = [];
var dofs_per_node = 3;              // dof p of node a is dofs_per_node a + p

// A field of the VTU output: the dofs first .. first + count - 1 of each
// node. mesh_clear sets the one field u, the dofs 0 to 2. A lane that
// changes dofs_per_node sets its own fields, for example the temperature
// (count 1) or the rotations of a shell (first 3, count 3).
struct Field {
    name: u8[..64],
    first: i64,
    count: i64,
}

var point_fields: Field[>..] = [];

// A named set is a range of `set_items`: a node index for a node set, or
// 6 c + f (local face f of cell c) for a face set. The local faces of a
// cell type are in the order of its registry entry.
var set_names: u8[..64][>..] = [];
var set_is_face: bool[>..] = [];
var set_start: i64[>..] = [0];
var set_items: i64[>..] = [];

let FACE_STRIDE = 6;

fn node_count() -> i64 { return coords.len / 3; }
fn cell_count() -> i64 { return cell_type.len; }

fn mesh_clear() {
    dofs_per_node = 3;
    point_fields.clear();
    add_point_field("u", 0, 3);
    coords.clear();
    cell_type.clear();
    cell_start.clear();
    cell_start.push(0);
    cell_nodes.clear();
    set_names.clear();
    set_is_face.clear();
    set_start.clear();
    set_start.push(0);
    set_items.clear();
}

fn add_point_field(name: const u8[:], first: i64, count: i64) {
    var f = Field { name: [], first: first, count: count };
    f.name.append(name[..min(name.len, 64)]);
    point_fields.push(f);
}

fn add_node(x: f64, y: f64, z: f64) -> i64 {
    coords.push(x);
    coords.push(y);
    coords.push(z);
    return node_count() - 1;
}

fn add_cell(t: i64, nodes: i64[:]) -> i64 {
    assert(t >= 0 && t < CELL_NODES.len && nodes.len == CELL_NODES[t]);
    cell_type.push(t as u8);
    for n in nodes { cell_nodes.push(n); }
    cell_start.push(cell_nodes.len);
    return cell_count() - 1;
}

fn cell_node(c: i64, l: i64) -> i64 { return cell_nodes[cell_start[c] + l]; }

fn add_set(name: const u8[:], face: bool, items: i64[:]) {
    var w: u8[..64] = [];
    w.append(name[..min(name.len, 64)]);
    set_names.push(w);
    set_is_face.push(face);
    for i in items { set_items.push(i); }
    set_start.push(set_items.len);
}

fn add_node_set(name: const u8[:], nodes: i64[:]) { add_set(name, false, nodes); }

// `faces` holds 6 c + f for local face f of cell c.
fn add_face_set(name: const u8[:], faces: i64[:]) { add_set(name, true, faces); }

// The index of the node set (face false) or the face set (face true)
// `name`, or -1. A node set and a face set can have the same name.
fn find_set(name: const u8[:], face: bool) -> i64 {
    for s, i in set_names {
        if s == name && set_is_face[i] == face { return i; }
    }
    return -1;
}

fn set_members(s: i64) -> const i64[:] { return set_items[set_start[s]..set_start[s + 1]]; }

// Whether the node sets a and b have a node in common.
fn sets_meet(a: i64, b: i64) -> bool {
    var mark: bool[>..] = [];
    for n in node_count() { mark.push(false); }
    for n in set_members(a) { mark[n] = true; }
    for n in set_members(b) {
        if mark[n] { return true; }
    }
    return false;
}

// --- the element registry ------------------------------------------------------------

// The shape functions of cell type t at the reference point xi: n[a] for
// each node a, and dn[3 a + r] = ∂N_a/∂ξ_r. A cell of dimension d < 3
// uses only the first d entries of xi and of each row of dn.
fn cell_shape(t: i64, xi: f64[3], n: f64[>..]&, dn: f64[>..]&) -> bool {
    n.clear();
    dn.clear();
    if t == HEX27 { hex27_shape(xi, n, dn); return true; }
    if t == HEX8I { hex8_shape(xi, n, dn); return true; }
    if t == QUAD4_SHELL || t == BEAM2 { return shells_shape(t, xi, n, dn); }
    return elements_shape(t, xi, n, dn);
}

// The quadrature of cell type t: xi[3 g + r] and the weight w[g] of each
// point g.
fn cell_quadrature(t: i64, xi: f64[>..]&, w: f64[>..]&) -> bool {
    xi.clear();
    w.clear();
    if t == HEX27 { gauss_hex3(xi, w); return true; }
    if t == HEX8I { gauss_hex2(xi, w); return true; }
    if t == QUAD4_SHELL || t == BEAM2 { return shells_quadrature(t, xi, w); }
    return elements_quadrature(t, xi, w);
}

// The element routine: the matrix of cell c into ke (row major, with
// dofs_per_node dofs for each node, dof p of node a at row
// dofs_per_node a + p). False if the cell type has no routine.
fn cell_matrix(c: i64, ke: f64[>..]&) -> bool {
    let t = cell_type[c] as i64;
    if t == HEX27 { return solid_stiffness(c, ke); }
    if t == HEX8I { return hex8i_matrix(c, ke); }
    if t == QUAD4_SHELL || t == BEAM2 { return shells_matrix(c, ke); }
    return elements_matrix(c, ke);
}

// The weights of a uniform load on local face f of cell c, for each local
// node a: w[4 a] is the integral of N_a over the face, and w[4 a + 1 + k]
// is the integral of N_a n_k, with n the unit normal out of the cell.
// False if the cell type has no face routine.
fn cell_face_weights(c: i64, f: i64, w: f64[>..]&) -> bool {
    w.clear();
    let t = cell_type[c] as i64;
    if t == HEX27 || t == HEX8I { hex_face_weights(c, f, w); return true; }
    if t == QUAD4_SHELL || t == BEAM2 { return shells_face_weights(c, f, w); }
    return elements_face_weights(c, f, w);
}

// Whether the reference point xi is in a cell of the 3D cell type t.
fn cell_inside(t: i64, xi: f64[3]) -> bool {
    if t == HEX27 || t == HEX8I { return max(abs(xi[0]), max(abs(xi[1]), abs(xi[2]))) <= 1.0 + 1.0e-9; }
    return elements_inside(t, xi);
}

// The tensor product of 3-point Gauss rules on [-1, 1]^3, x fastest.
fn gauss_hex3(xi: f64[>..]&, w: f64[>..]&) {
    for c in 3 {
        for b in 3 {
            for a in 3 {
                xi.push(GAUSS3_X[a]);
                xi.push(GAUSS3_X[b]);
                xi.push(GAUSS3_X[c]);
                w.push(GAUSS3_W[a] * GAUSS3_W[b] * GAUSS3_W[c]);
            }
        }
    }
}

let GAUSS3_X: f64[3] = [-0.7745966692414834, 0.0, 0.7745966692414834];
let GAUSS3_W: f64[3] = [0.5555555555555556, 0.8888888888888888, 0.5555555555555556];
