// The stiffness of the hex27 cell c, with 3 dofs for each node:
// K(i p, j q) = ∫ λ ∂p Ni ∂q Nj + μ (∂q Ni ∂p Nj + δpq ∇Ni · ∇Nj) dV.
fn hex27_stiffness(c: i64, ke: f64[>..]&) {
    guard c >= 0 && c < cell_count() && cell_type[c] as i64 == HEX27 && cell_start[c + 1] - cell_start[c] == 27 else { abort("hex27_stiffness: a hex27 cell with 27 nodes"); }
    guard cell_quadrature(HEX27, quad_xi, quad_w) else { return false; }
    ke.clear();
    for i in 81 * 81 { ke.push(0.0); }
    grad.clear();
    for i in 81 { grad.push(0.0); }
    let lambda = young * poisson / ((1.0 + poisson) * (1.0 - 2.0 * poisson));
    let mu = young / (2.0 * (1.0 + poisson));
    for w, g in quad_w {
        let xi: f64[3] = [quad_xi[3 * g], quad_xi[3 * g + 1], quad_xi[3 * g + 2]];
        guard cell_shape(HEX27, xi, shape_n, shape_dn) else { return false; }
        var jac: f64[9] = [0.0; 9];
        cell_jacobian(c, shape_dn, jac);
        var inv: f64[9] = [0.0; 9];
        let det = inverse3(jac, inv);
        assert(det > 0.0);
        for l in 27 {
            for s in 3 {
                grad[3 * l + s] = inv[3 * s] * shape_dn[3 * l] + inv[3 * s + 1] * shape_dn[3 * l + 1]
                    + inv[3 * s + 2] * shape_dn[3 * l + 2];
            }
        }
        let dv = w * det;
        hex27_stiffness_0_0(grad, lambda, mu, dv, ke);
        hex27_stiffness_0_1(grad, lambda, mu, dv, ke);
        hex27_stiffness_0_2(grad, lambda, mu, dv, ke);
        hex27_stiffness_1_0(grad, lambda, mu, dv, ke);
        hex27_stiffness_1_1(grad, lambda, mu, dv, ke);
        hex27_stiffness_1_2(grad, lambda, mu, dv, ke);
        hex27_stiffness_2_0(grad, lambda, mu, dv, ke);
        hex27_stiffness_2_1(grad, lambda, mu, dv, ke);
        hex27_stiffness_2_2(grad, lambda, mu, dv, ke);
    }
    return true;
}

// Block (0, 0) of hex8i_full: the rows of node group 0, the columns of node group 0.
fn hex8i_full_0_0(grad: f64[:], lambda: f64, mu: f64, dv: f64, ke: f64[>..]&) {
    guard grad.len == 33 && ke.len == 33 * 33 else { abort("hex8i_full_0_0: grad.len == 33 && ke.len == 33 * 33"); }
    for i in 0..8 {
        for j in 0..8 {
            let dot = grad[3 * i] * grad[3 * j] + grad[3 * i + 1] * grad[3 * j + 1]
                + grad[3 * i + 2] * grad[3 * j + 2];
            let row = 99 * i + 3 * j;
            var v = lambda * grad[3 * i] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j];
            v += mu * dot;
            ke[row] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j];
            ke[row + 1] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j];
            ke[row + 2] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 1];
            ke[row + 33] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 1];
            v += mu * dot;
            ke[row + 34] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 1];
            ke[row + 35] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 2];
            ke[row + 66] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 2];
            ke[row + 67] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 2];
            v += mu * dot;
            ke[row + 68] += v * dv;
        }
    }
}

// Block (0, 1) of hex8i_full: the rows of node group 0, the columns of node group 1.
fn hex8i_full_0_1(grad: f64[:], lambda: f64, mu: f64, dv: f64, ke: f64[>..]&) {
    guard grad.len == 33 && ke.len == 33 * 33 else { abort("hex8i_full_0_1: grad.len == 33 && ke.len == 33 * 33"); }
    for i in 0..8 {
        for j in 8..11 {
            let dot = grad[3 * i] * grad[3 * j] + grad[3 * i + 1] * grad[3 * j + 1]
                + grad[3 * i + 2] * grad[3 * j + 2];
            let row = 99 * i + 3 * j;
            var v = lambda * grad[3 * i] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j];
            v += mu * dot;
            ke[row] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j];
            ke[row + 1] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j];
            ke[row + 2] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 1];
            ke[row + 33] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 1];
            v += mu * dot;
            ke[row + 34] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 1];
            ke[row + 35] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 2];
            ke[row + 66] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 2];
            ke[row + 67] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 2];
            v += mu * dot;
            ke[row + 68] += v * dv;
        }
    }
}

// Block (1, 0) of hex8i_full: the rows of node group 1, the columns of node group 0.
fn hex8i_full_1_0(grad: f64[:], lambda: f64, mu: f64, dv: f64, ke: f64[>..]&) {
    guard grad.len == 33 && ke.len == 33 * 33 else { abort("hex8i_full_1_0: grad.len == 33 && ke.len == 33 * 33"); }
    for i in 8..11 {
        for j in 0..8 {
            let dot = grad[3 * i] * grad[3 * j] + grad[3 * i + 1] * grad[3 * j + 1]
                + grad[3 * i + 2] * grad[3 * j + 2];
            let row = 99 * i + 3 * j;
            var v = lambda * grad[3 * i] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j];
            v += mu * dot;
            ke[row] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j];
            ke[row + 1] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j];
            ke[row + 2] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 1];
            ke[row + 33] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 1];
            v += mu * dot;
            ke[row + 34] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 1];
            ke[row + 35] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 2];
            ke[row + 66] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 2];
            ke[row + 67] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 2];
            v += mu * dot;
            ke[row + 68] += v * dv;
        }
    }
}

// Block (1, 1) of hex8i_full: the rows of node group 1, the columns of node group 1.
fn hex8i_full_1_1(grad: f64[:], lambda: f64, mu: f64, dv: f64, ke: f64[>..]&) {
    guard grad.len == 33 && ke.len == 33 * 33 else { abort("hex8i_full_1_1: grad.len == 33 && ke.len == 33 * 33"); }
    for i in 8..11 {
        for j in 8..11 {
            let dot = grad[3 * i] * grad[3 * j] + grad[3 * i + 1] * grad[3 * j + 1]
                + grad[3 * i + 2] * grad[3 * j + 2];
            let row = 99 * i + 3 * j;
            var v = lambda * grad[3 * i] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j];
            v += mu * dot;
            ke[row] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j];
            ke[row + 1] += v * dv;
            v = lambda * grad[3 * i] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j];
            ke[row + 2] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 1];
            ke[row + 33] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 1];
            v += mu * dot;
            ke[row + 34] += v * dv;
            v = lambda * grad[3 * i + 1] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 1];
            ke[row + 35] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j] + mu * grad[3 * i] * grad[3 * j + 2];
            ke[row + 66] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 1] + mu * grad[3 * i + 1] * grad[3 * j + 2];
            ke[row + 67] += v * dv;
            v = lambda * grad[3 * i + 2] * grad[3 * j + 2] + mu * grad[3 * i + 2] * grad[3 * j + 2];
            v += mu * dot;
            ke[row + 68] += v * dv;
        }
    }
}

// The 33 × 33 matrix `full` of the 8 nodes and the 3 modes of the hex8i
// cell c, with the integrand of hex27_stiffness.
fn hex8i_full(c: i64) {
    guard c >= 0 && c < cell_count() && cell_type[c] as i64 == HEX8I && cell_start[c + 1] - cell_start[c] == 8 else { abort("hex8i_full: a hex8i cell with 8 nodes"); }
    quad_xi.clear();
    quad_w.clear();
    gauss_hex2(quad_xi, quad_w);
    full.clear();
    for i in ALL_DOFS * ALL_DOFS { full.push(0.0); }
    grad.clear();
    for i in ALL_DOFS { grad.push(0.0); }
    let lambda = young * poisson / ((1.0 + poisson) * (1.0 - 2.0 * poisson));
    let mu = young / (2.0 * (1.0 + poisson));
    for w, g in quad_w {
        let xi: f64[3] = [quad_xi[3 * g], quad_xi[3 * g + 1], quad_xi[3 * g + 2]];
        shape_n.clear();
        shape_dn.clear();
        hex8_shape(xi, shape_n, shape_dn);
        var jac: f64[9] = [0.0; 9];
        cell_jacobian(c, shape_dn, jac);
        var inv: f64[9] = [0.0; 9];
        let det = inverse3(jac, inv);
        assert(det > 0.0);
        for l in 8 {
            for s in 3 {
                grad[3 * l + s] = inv[3 * s] * shape_dn[3 * l] + inv[3 * s + 1] * shape_dn[3 * l + 1]
                    + inv[3 * s + 2] * shape_dn[3 * l + 2];
            }
        }
        mode_gradient(c, xi, det, grad, NODE_DOFS);
        let dv = w * det;
        hex8i_full_0_0(grad, lambda, mu, dv, full);
        hex8i_full_0_1(grad, lambda, mu, dv, full);
        hex8i_full_1_0(grad, lambda, mu, dv, full);
        hex8i_full_1_1(grad, lambda, mu, dv, full);
    }
}
