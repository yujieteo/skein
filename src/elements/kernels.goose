fn elastic_tet10(c: i64) {
    guard c >= 0 && c < cell_count() && physics == ELASTIC && dim == 3 && per_cell == 10 && ncomp == 3 else { abort("elastic_tet10: a cell, the physics, dim 3, 10 nodes and 3 components"); }
    for &v in ke { v = 0.0; }
    for &v in fe { v = 0.0; }
    for qp in quad_count(3) {
        let xi, w = quad_point(3, qp);
        let dv = w * cell_geometry(c, xi) * thickness;
        for i in 10 {
            fe[3 * i] += volume_force[0] * shp[i] * dv;
            fe[3 * i + 1] += volume_force[1] * shp[i] * dv;
            fe[3 * i + 2] += volume_force[2] * shp[i] * dv;
        }
        elastic_tet10_0_0(dv);
        elastic_tet10_0_1(dv);
        elastic_tet10_1_0(dv);
        elastic_tet10_1_1(dv);
    }
}

fn heat_tri3(c: i64) {
    guard c >= 0 && c < cell_count() && physics == HEAT && dim == 2 && per_cell == 3 && ncomp == 1 else { abort("heat_tri3: a cell, the physics, dim 2, 3 nodes and 1 components"); }
    for &v in ke { v = 0.0; }
    for &v in fe { v = 0.0; }
    for qp in quad_count(2) {
        let xi, w = quad_point(2, qp);
        let dv = w * cell_geometry(c, xi) * thickness;
        let kq = conductivity_at(c);
        for i in 3 {
            fe[i] += source * shp[i] * dv;
        }
        for i in 0..3 {
            for j in 0..3 {
                var dot = 0.0;
                dot += grad[3 * i] * grad[3 * j];
                dot += grad[3 * i + 1] * grad[3 * j + 1];
                ke[3 * i + j] += kq * dot * dv;
            }
        }
    }
}

