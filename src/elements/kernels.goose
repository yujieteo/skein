}

// Block (1, 1) of elastic_tri6: the rows of node group 1, the columns of node group 1.
fn elastic_tri6_1_1(dv: f64) {
    guard per_cell == 6 && ncomp == 2 else { abort("elastic_tri6_1_1: per_cell == 6 && ncomp == 2"); }
    for i in 3..6 {
        for j in 3..6 {
            var dot = 0.0;
            dot += grad[3 * i] * grad[3 * j];
            dot += grad[3 * i + 1] * grad[3 * j + 1];
            let row = 24 * i + 2 * j;
            var v = lame * grad[3 * i] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j];
            v += shear * dot;
            ke[row] += v * dv;
            v = lame * grad[3 * i] * grad[3 * j + 1] + shear * grad[3 * i + 1] * grad[3 * j];
            ke[row + 1] += v * dv;
            v = lame * grad[3 * i + 1] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j + 1];
