}

// Block (1, 0) of elastic_tri6: the rows of node group 1, the columns of node group 0.
fn elastic_tri6_1_0(dv: f64) {
    guard per_cell == 6 && ncomp == 2 else { abort("elastic_tri6_1_0: per_cell == 6 && ncomp == 2"); }
