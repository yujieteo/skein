fn elastic_tri6(c: i64) {
    guard c >= 0 && c < cell_count() && physics == ELASTIC && dim == 2 && per_cell == 6 && ncomp == 2 else { abort("elastic_tri6: a cell, the physics, dim 2, 6 nodes and 2 components"); }
    for &v in ke { v = 0.0; }
    for &v in fe { v = 0.0; }
    for qp in quad_count(2) {
        let xi, w = quad_point(2, qp);
        let dv = w * cell_geometry(c, xi) * thickness;
        for i in 6 {
            fe[2 * i] += volume_force[0] * shp[i] * dv;
            fe[2 * i + 1] += volume_force[1] * shp[i] * dv;
        }
        elastic_tri6_0_0(dv);
        elastic_tri6_0_1(dv);
        elastic_tri6_1_0(dv);
        elastic_tri6_1_1(dv);
    }
}

fn elastic_tet4(c: i64) {
    guard c >= 0 && c < cell_count() && physics == ELASTIC && dim == 3 && per_cell == 4 && ncomp == 3 else { abort("elastic_tet4: a cell, the physics, dim 3, 4 nodes and 3 components"); }
    for &v in ke { v = 0.0; }
    for &v in fe { v = 0.0; }
    for qp in quad_count(3) {
        let xi, w = quad_point(3, qp);
        let dv = w * cell_geometry(c, xi) * thickness;
        for i in 4 {
            fe[3 * i] += volume_force[0] * shp[i] * dv;
            fe[3 * i + 1] += volume_force[1] * shp[i] * dv;
            fe[3 * i + 2] += volume_force[2] * shp[i] * dv;
        }
        for i in 0..4 {
            for j in 0..4 {
                var dot = 0.0;
                dot += grad[3 * i] * grad[3 * j];
                dot += grad[3 * i + 1] * grad[3 * j + 1];
                dot += grad[3 * i + 2] * grad[3 * j + 2];
                let row = 36 * i + 3 * j;
                var v = lame * grad[3 * i] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j];
                v += shear * dot;
                ke[row] += v * dv;
                v = lame * grad[3 * i] * grad[3 * j + 1] + shear * grad[3 * i + 1] * grad[3 * j];
                ke[row + 1] += v * dv;
                v = lame * grad[3 * i] * grad[3 * j + 2] + shear * grad[3 * i + 2] * grad[3 * j];
                ke[row + 2] += v * dv;
                v = lame * grad[3 * i + 1] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j + 1];
                ke[row + 12] += v * dv;
                v = lame * grad[3 * i + 1] * grad[3 * j + 1] + shear * grad[3 * i + 1] * grad[3 * j + 1];
                v += shear * dot;
                ke[row + 13] += v * dv;
                v = lame * grad[3 * i + 1] * grad[3 * j + 2] + shear * grad[3 * i + 2] * grad[3 * j + 1];
                ke[row + 14] += v * dv;
                v = lame * grad[3 * i + 2] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j + 2];
                ke[row + 24] += v * dv;
                v = lame * grad[3 * i + 2] * grad[3 * j + 1] + shear * grad[3 * i + 1] * grad[3 * j + 2];
                ke[row + 25] += v * dv;
                v = lame * grad[3 * i + 2] * grad[3 * j + 2] + shear * grad[3 * i + 2] * grad[3 * j + 2];
                v += shear * dot;
                ke[row + 26] += v * dv;
            }
        }
    }
}

// Block (0, 0) of elastic_tet10: the rows of node group 0, the columns of node group 0.
fn elastic_tet10_0_0(dv: f64) {
    guard per_cell == 10 && ncomp == 3 else { abort("elastic_tet10_0_0: per_cell == 10 && ncomp == 3"); }
    for i in 0..4 {
        for j in 0..4 {
            var dot = 0.0;
            dot += grad[3 * i] * grad[3 * j];
            dot += grad[3 * i + 1] * grad[3 * j + 1];
            dot += grad[3 * i + 2] * grad[3 * j + 2];
            let row = 90 * i + 3 * j;
            var v = lame * grad[3 * i] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j];
            v += shear * dot;
            ke[row] += v * dv;
            v = lame * grad[3 * i] * grad[3 * j + 1] + shear * grad[3 * i + 1] * grad[3 * j];
            ke[row + 1] += v * dv;
            v = lame * grad[3 * i] * grad[3 * j + 2] + shear * grad[3 * i + 2] * grad[3 * j];
            ke[row + 2] += v * dv;
            v = lame * grad[3 * i + 1] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j + 1];
            ke[row + 30] += v * dv;
            v = lame * grad[3 * i + 1] * grad[3 * j + 1] + shear * grad[3 * i + 1] * grad[3 * j + 1];
            v += shear * dot;
            ke[row + 31] += v * dv;
            v = lame * grad[3 * i + 1] * grad[3 * j + 2] + shear * grad[3 * i + 2] * grad[3 * j + 1];
            ke[row + 32] += v * dv;
            v = lame * grad[3 * i + 2] * grad[3 * j] + shear * grad[3 * i] * grad[3 * j + 2];
            ke[row + 60] += v * dv;
            v = lame * grad[3 * i + 2] * grad[3 * j + 1] + shear * grad[3 * i + 1] * grad[3 * j + 2];
            ke[row + 61] += v * dv;
            v = lame * grad[3 * i + 2] * grad[3 * j + 2] + shear * grad[3 * i + 2] * grad[3 * j + 2];
            v += shear * dot;
            ke[row + 62] += v * dv;
        }
    }
}

