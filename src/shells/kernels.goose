// The cell kernels of the shells and the beams, written by the emitter of the cell kernels
// (src/codegen/kernels.goose). Do not edit this file: edit the emitter,
// then run `build/test_codegen write` from the root of the repository.
import std;
namespace shells;
import .model;
import .mitc4;
import .beam;

// Block (0, 0) of shell_stiffness: the rows of node group 0, the columns of node group 0.
fn shell_stiffness_0_0(kd: f64, gen: f64[:]) {
    guard gen.len == 192 else { abort("shell_stiffness_0_0: gen.len == 192"); }
    for i in 0..12 {
        for j in 0..12 {
            var v = kd * rows[192 + i] * rows[192 + j];
            v += rows[i] * gen[j];
            v += rows[24 + i] * gen[24 + j];
            v += rows[48 + i] * gen[48 + j];
            v += rows[72 + i] * gen[72 + j];
            v += rows[96 + i] * gen[96 + j];
            v += rows[120 + i] * gen[120 + j];
            v += rows[144 + i] * gen[144 + j];
            v += rows[168 + i] * gen[168 + j];
            ke[24 * i + j] += v * area;
        }
    }
}

// Block (0, 1) of shell_stiffness: the rows of node group 0, the columns of node group 1.
fn shell_stiffness_0_1(kd: f64, gen: f64[:]) {
    guard gen.len == 192 else { abort("shell_stiffness_0_1: gen.len == 192"); }
    for i in 0..12 {
        for j in 12..24 {
            var v = kd * rows[192 + i] * rows[192 + j];
            v += rows[i] * gen[j];
            v += rows[24 + i] * gen[24 + j];
            v += rows[48 + i] * gen[48 + j];
            v += rows[72 + i] * gen[72 + j];
            v += rows[96 + i] * gen[96 + j];
            v += rows[120 + i] * gen[120 + j];
            v += rows[144 + i] * gen[144 + j];
            v += rows[168 + i] * gen[168 + j];
            ke[24 * i + j] += v * area;
        }
    }
}

