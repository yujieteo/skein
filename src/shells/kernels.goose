// Block (1, 1) of shell_stiffness: the rows of node group 1, the columns of node group 1.
fn shell_stiffness_1_1(kd: f64, gen: f64[:]) {
    guard gen.len == 192 else { abort("shell_stiffness_1_1: gen.len == 192"); }
    for i in 12..24 {
        for j in 12..24 {
            var v = kd * rows[192 + i] * rows[192 + j];
            v += rows[i] * gen[j];
            v += rows[24 + i] * gen[24 + j];
            v += rows[48 + i] * gen[48 + j];
            v += rows[72 + i] * gen[72 + j];
            v += rows[96 + i] * gen[96 + j];
            v += rows[120 + i] * gen[120 + j];
            v += rows[144 + i] * gen[144 + j];
            v += rows[168 + i] * gen[168 + j];
            ke[24 * i + j] += v * area;
        }
    }
}

// The stiffness ke of shell cell c, by 2 × 2 Gauss points.
fn shell_stiffness(c: i64) {
    guard c >= 0 && c < shells.len && shells[c].section >= 0 && shells[c].section < sections.len else { abort("shell_stiffness: 0 <= c < shells.len, and its section < sections.len"); }
    load_cell(c);
    let s = sections[shells[c].section];
    let kd = DRILL * s.a[8];
    for &v in ke { v = 0.0; }
    var gen: f64[192] = [0.0; 192];      // N, M and Q of each dof column j: 8 rows of 24
    for gp in 4 {
        let xi = if gp % 2 == 0 { -GAUSS } else { GAUSS };
        let eta = if gp < 2 { -GAUSS } else { GAUSS };
        local_rows(c, xi, eta);
        for j in 24 {
            let am = mat3_row(s.a, 0, j);
            let bk = mat3_row(s.b, 72, j);
            let bm = mat3_row(s.b, 0, j);
            let dk = mat3_row(s.d, 72, j);
            for k in 3 {
                gen[24 * k + j] = am[k] + bk[k];
                gen[72 + 24 * k + j] = bm[k] + dk[k];
            }
            gen[144 + j] = s.s[0] * rows[144 + j] + s.s[1] * rows[168 + j];
            gen[168 + j] = s.s[2] * rows[144 + j] + s.s[3] * rows[168 + j];
        }
        shell_stiffness_0_0(kd, gen);
        shell_stiffness_0_1(kd, gen);
        shell_stiffness_1_0(kd, gen);
        shell_stiffness_1_1(kd, gen);
    }
}

// The stiffness of beam b in global dofs: tbᵀ kb tb, into out[0..144].
fn beam_stiffness(b: i64, out: f64[:]) {
    guard b >= 0 && b < beams.len && out.len == 144 else { abort("beam_stiffness: 0 <= b < beams.len, and out has 144 entries"); }
    beam_local(b);
    var kt: f64[144] = [0.0; 144];
    for i in 12 {
        for j in 12 {
            var v = 0.0;
            for k in 12 { v += kb[12 * i + k] * tb[12 * k + j]; }
            kt[12 * i + j] = v;
        }
    }
    for i in 12 {
        for j in 12 {
            var v = 0.0;
            for k in 12 { v += tb[12 * k + i] * kt[12 * k + j]; }
            out[12 * i + j] = v;
        }
    }
}
